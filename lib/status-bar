#!/usr/bin/env bash
# status-bar - tmux status renderer for the agent-manager dedicated server.
#
# Renders all am sessions as a clickable tab strip. Whole bottom bar acts as
# a tab switcher: each tab carries index, state glyph, label (dir/branch),
# title (task), and age — as much of that as fits. The layout is adaptive: a
# few sessions on a wide terminal show everything in full; as sessions
# multiply or the terminal narrows, the strip degrades in steps (see
# _fit_strip) instead of trimming every field to an unreadable stub.
# Clicking a tab in status-left switches to that session via MouseDown1Status.
#
# Outputs:
# - stdout: clickable tab strip wrapped in #[range=user|<sid>]…#[norange],
#   consumed by status-left.
# - @am_sidebar tmux option: compact tab strip (labels only, no range
#   wrappers) consumed by pane-border-format.
#
# Called by tmux as: #(/path/to/status-bar #{session_name})

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/utils.sh"
source "$SCRIPT_DIR/tmux.sh"
source "$SCRIPT_DIR/registry.sh"
source "$SCRIPT_DIR/state.sh"

# Modes: --print emits clickable strip on stdout (used by tests and ad-hoc
# inspection). Default mode runs only for side effects: writes per-session
# @am_status_left and @am_sidebar options. Keeping stdout empty in default
# mode lets tmux invoke the script for periodic refresh (via a #() in
# status-right) without polluting the rendered bar.
print_mode=false
if [[ "${1:-}" == "--print" ]]; then
    print_mode=true
    shift
fi

current="${1:-}"
AM_STATE_DIR="${AM_STATE_DIR:-/tmp/am-state}"

# Layout thresholds (chars; every glyph counts as 1 col).
# A two-field tab ("label · title") is only worth showing while each field
# keeps at least BOTH_FLOOR chars — below that both halves are stubs and one
# readable field beats two fragments. Ages are dropped once even that single
# field would fall under AGE_FLOOR chars.
BOTH_FLOOR=12
AGE_FLOOR=8
# Default branches carry no information next to the directory name.
DEFAULT_BRANCHES=" main master "
TAB_SEP=" "
UNLIMITED=9999

# State lookup tables — avoid spawning a subshell per session for the glyph
# and color helpers. Status-bar runs on the hot path between Enter and attach;
# eliminating these $()  forks is the difference between "instant" and "lag".
declare -A GLYPH=(
    [running]='▸'
    [ready]='●'
    [waiting_user]='⚠'
    [background]='⧗'
    [starting]='◌'
    [unknown]='?'
    [dead]='✕'
)
declare -A COLOR=(
    [running]='colour75'
    [ready]='colour114'
    [waiting_user]='colour214'
    [background]='colour44'
    [starting]='colour221'
    [unknown]='colour244'
    [dead]='colour196'
)
# Age shade per state: the tab's own hue, a step darker. A neutral grey age
# floated between two tabs and read as belonging to either; the matching hue
# ties it to its tab while still sitting behind the label and title.
declare -A COLOR_DIM=(
    [running]='colour67'
    [ready]='colour71'
    [waiting_user]='colour172'
    [background]='colour37'
    [starting]='colour179'
    [unknown]='colour240'
    [dead]='colour124'
)

# Truncate to `_T` with a single-col ellipsis (no $() fork). Caller reads `$_T`.
_trunc() {
    local s="$1" max="$2"
    if (( ${#s} > max )); then
        _T="${s:0:$((max - 1))}…"
    else
        _T="$s"
    fi
}

# Compact age to `_A` (no $() fork). Caller reads `$_A`.
_compact_age_set() {
    local s="$1"
    (( s < 0 )) && s=0
    if   (( s < 60 ));    then _A="${s}s"
    elif (( s < 3600 ));  then _A="$((s/60))m"
    elif (( s < 86400 )); then _A="$((s/3600))h"
    else                       _A="$((s/86400))d"
    fi
}

# State detection is delegated to lib/state.sh `_state_resolve` with bulk
# fixtures so we share the resolver with `agent_get_state` instead of
# maintaining a parallel implementation that drifts (see the historical
# ▸-in-sidebar / ●-in-browser divergence). The bulk fixtures SESSION_TOP_PID
# / PROC_COMM / PROC_CHILDREN are built once below and passed by nameref.

# Single tmux call returns ordering + activity timestamps. Sort by creation
# time ascending so newly created sessions always appear at the end (stable
# numbering for prefix+1..9 keybindings).
mapfile -t session_meta < <(am_tmux list-sessions -F '#{session_created} #{session_activity} #{session_name}' 2>/dev/null \
    | grep " ${AM_SESSION_PREFIX}" \
    | sort -k1,1n -k3,3 || true)

[[ ${#session_meta[@]} -eq 0 ]] && exit 0

# Refresh registry task field from pane titles / Claude JSONL fallback before
# the bulk read below. Self-throttled to 60s via $AM_DIR/.title_scan_last, so
# the 5s status-interval tick stays cheap. Without this, brand-new sessions
# (and post-/clear conversations) stay untitled in the status bar until the
# user runs `am`.
auto_title_scan >/dev/null 2>&1 || true

# Bulk registry read — one jq invocation for all sessions' fields, indexed by
# name into associative arrays. Replaces N separate `registry_get_fields`
# calls (each forking jq) with a single fork.
declare -A REG_DIR=() REG_BRANCH=() REG_AGENT=() REG_TASK=() REG_WORKDIR=()
if [[ -r "${AM_REGISTRY:-}" ]]; then
    while IFS=$'\x1f' read -r _reg_name _reg_dir _reg_branch _reg_agent _reg_task _reg_workdir; do
        [[ -n "$_reg_name" ]] || continue
        REG_DIR[$_reg_name]=$_reg_dir
        REG_BRANCH[$_reg_name]=$_reg_branch
        REG_AGENT[$_reg_name]=$_reg_agent
        REG_TASK[$_reg_name]=$_reg_task
        REG_WORKDIR[$_reg_name]=$_reg_workdir
    done < <(jq -r --arg us $'\x1f' '
        .sessions | to_entries[] |
        [.key, (.value.directory // ""), (.value.branch // ""),
         (.value.agent_type // ""), (.value.task // ""), (.value.workdir // "")] | join($us)
    ' "$AM_REGISTRY" 2>/dev/null || true)
fi

now=$(date +%s)

# Available width for the tab strip. tmux clips status-left at the terminal
# width (minus whatever status-right renders), so with 5+ sessions the right-
# most tabs fall off the edge. Use the narrowest attached client so the strip
# fits every client; _fit_strip measures real geometry and degrades the
# layout only as much as needed (wide terminals keep full labels + titles).
# AM_STATUS_WIDTH overrides the probe (tests, ad-hoc inspection of the layout
# at a given width). Falls back to a sane default when no client is attached
# (e.g. precompute during session creation).
_AVAIL_WIDTH=0
if [[ "${AM_STATUS_WIDTH:-}" =~ ^[0-9]+$ ]]; then
    _AVAIL_WIDTH=$AM_STATUS_WIDTH
else
    while IFS= read -r _cw; do
        [[ "$_cw" =~ ^[0-9]+$ ]] || continue
        if (( _AVAIL_WIDTH == 0 || _cw < _AVAIL_WIDTH )); then
            _AVAIL_WIDTH=$_cw
        fi
    done < <(am_tmux list-clients -F '#{client_width}' 2>/dev/null || true)
fi
(( _AVAIL_WIDTH == 0 )) && _AVAIL_WIDTH=200
(( _AVAIL_WIDTH < 40 )) && _AVAIL_WIDTH=40

# Bulk pane-pid + pane-title fetch: one tmux list-panes call indexes the top
# pane for each session. Replaces N `display-message` forks inside the loop.
# Title is the last field so embedded '|' in a title cannot shift the parse.
# A hidden shell panel (parked in the $AM_SHELL_WINDOW window) is also "at
# top" of its own window and must be skipped, or its shell pid would clobber
# the agent pid and flip running sessions to idle.
declare -A SESSION_TOP_PID=() SESSION_TITLE=()
while IFS='|' read -r _bp_sess _bp_top _bp_win _bp_pid _bp_title; do
    [[ "$_bp_top" == "1" ]] || continue
    [[ "$_bp_win" == "$AM_SHELL_WINDOW" ]] && continue
    [[ "$_bp_sess" == "${AM_SESSION_PREFIX}"* ]] || continue
    SESSION_TOP_PID[$_bp_sess]=$_bp_pid
    SESSION_TITLE[$_bp_sess]=$_bp_title
done < <(am_tmux list-panes -a -F '#{session_name}|#{pane_at_top}|#{window_name}|#{pane_pid}|#{pane_title}' 2>/dev/null || true)

# Bulk process-table fetch: one ps -eo call yields comm + children for every
# pid. Replaces ~3 ps forks per session in _state_pane_is_shell.
declare -A PROC_COMM=() PROC_CHILDREN=()
while read -r _bp_p _bp_pp _bp_c; do
    [[ -z "$_bp_p" || "$_bp_p" == "PID" ]] && continue
    PROC_COMM[$_bp_p]=$_bp_c
    PROC_CHILDREN[$_bp_pp]="${PROC_CHILDREN[$_bp_pp]:-} $_bp_p"
done < <(ps -eo pid=,ppid=,comm= 2>/dev/null || true)

# Pass 1: collect per-session data once. We then format N strip variants
# (one per "perspective session") using this cached data, so each session's
# @am_status_left option holds a strip with itself marked as current. tmux
# then reads the precomputed option on session switch — instant feedback,
# no async #() job to wait on.
declare -a S_NAME S_LABEL_FULL S_LABEL_SHORT S_STATE S_GLYPH S_COLOR S_DIM S_TASK S_AGE

for i in "${!session_meta[@]}"; do
    # Bash-only parse of "<created> <activity> <name>" — no awk fork.
    read -r _created activity session <<< "${session_meta[$i]}"

    dir="${REG_DIR[$session]:-}"
    branch="${REG_BRANCH[$session]:-}"
    agent_type="${REG_AGENT[$session]:-}"
    task="${REG_TASK[$session]:-}"

    # Labels (basename via parameter expansion, no basename fork):
    #   full  = "dir/branch", with default branches hidden — `agent-manager`,
    #           not `agent-manager/main`, since the branch adds nothing there.
    #   short = the more specific half: the branch when the session is on a
    #           feature branch (pool copies like `pink-wekapp` are noise next
    #           to `dependency-pr-shepherd`), else the directory.
    # Sessions with no directory fall back to the bare session id.
    # The label follows where the agent works *now* (registry `workdir`, set
    # when it moved to another checkout); state detection below keeps using
    # the launch directory.
    label_dir="${REG_WORKDIR[$session]:-$dir}"
    if [[ -n "$label_dir" ]]; then
        label_full="${label_dir##*/}"
        label_short="$label_full"
        if [[ -n "$branch" && "$DEFAULT_BRANCHES" != *" $branch "* ]]; then
            label_full+="/$branch"
            label_short="$branch"
        fi
    else
        label_full="${session#"${AM_SESSION_PREFIX}"}"
        label_short="$label_full"
    fi

    state=$(_state_resolve "$session" "$agent_type" "$dir" \
        SESSION_TOP_PID PROC_COMM PROC_CHILDREN "$now" "$activity" SESSION_TITLE "$_created")
    [[ -z "$state" ]] && state="idle"

    # Tab age = time in current state. The hook state file's mtime is the
    # moment the state was entered (same-state rewrites are skipped), so a
    # waiting tab reads "waiting for you since" and a running tab "running
    # for". tmux session_activity is useless for either — viewing the tab
    # refreshes it, so it reads as "since I last looked"; it remains the
    # fallback for states without a hook file (idle, non-hook agents).
    age=""
    _age_ref=""
    if [[ "$state" == "ready" || "$state" == "waiting_user" \
        || "$state" == "background" || "$state" == "running" ]]; then
        _age_ref=$(stat -c %Y "$AM_STATE_DIR/$session" 2>/dev/null \
            || stat -f %m "$AM_STATE_DIR/$session" 2>/dev/null || true)
        [[ "$_age_ref" =~ ^[0-9]+$ ]] || _age_ref=""
    fi
    if [[ -z "$_age_ref" && "$activity" =~ ^[0-9]+$ ]]; then
        _age_ref=$activity
    fi
    if [[ -n "$_age_ref" ]]; then
        _compact_age_set $(( now - _age_ref ))
        age="$_A"
    fi

    S_NAME[i]=$session
    S_LABEL_FULL[i]=$label_full
    S_LABEL_SHORT[i]=$label_short
    S_STATE[i]=$state
    S_GLYPH[i]="${GLYPH[$state]:-○}"
    S_COLOR[i]="${COLOR[$state]:-colour240}"
    S_DIM[i]="${COLOR_DIM[$state]:-colour238}"
    S_TASK[i]=$task
    S_AGE[i]=$age
done

# --- Layout fitting ---------------------------------------------------------
#
# A "fit" is (labels, tasks, ages, cap):
#   labels: full | short        which label variant the tabs use
#   tasks:  both | only | none  both → "label · title"; only → title (label
#                               for untitled sessions); none → label
#   ages:   true | false
#   cap:    max chars per text field before "…" truncation
# The whole strip shares one fit — the current tab differs only in colour,
# since the user already knows what they are looking at and the other tabs
# are where the text has to earn its space — so it is computed once per
# variant (status-left, sidebar) and reused for every perspective.

# Text fields of tab i under (labels, tasks) → `_F1` (always) and `_F2`
# (second field; empty when the tab has one). _measure and _render_tab both
# go through here so the fit search measures exactly what gets drawn.
_tab_fields() {
    local i="$1" labels="$2" tasks="$3"
    if [[ "$labels" == full ]]; then _F1="${S_LABEL_FULL[$i]}"; else _F1="${S_LABEL_SHORT[$i]}"; fi
    _F2=""
    case "$tasks" in
        both) _F2="${S_TASK[$i]}" ;;
        only) if [[ -n "${S_TASK[$i]}" ]]; then _F1="${S_TASK[$i]}"; fi ;;
    esac
}

# Measure a layout: `_FIXED` = cols that never shrink (pads, idx, glyph,
# spaces, " · " joins, ages, separators); `_WF_LENS` = natural length of every
# text field. The strip fits unshrunk iff _FIXED + Σ_WF_LENS ≤ avail.
_measure() {
    local labels="$1" tasks="$2" ages="$3"
    local i idx
    _FIXED=$(( ${#TAB_SEP} * (${#S_NAME[@]} - 1) ))
    _WF_LENS=()
    for i in "${!S_NAME[@]}"; do
        idx=$((i + 1))
        _FIXED=$(( _FIXED + ${#idx} + 4 ))          # " idx glyph text " → pads + glyph + space
        _tab_fields "$i" "$labels" "$tasks"
        _WF_LENS+=("${#_F1}")
        if [[ -n "$_F2" ]]; then
            _FIXED=$(( _FIXED + 3 ))                 # " · "
            _WF_LENS+=("${#_F2}")
        fi
        if [[ "$ages" == true && -n "${S_AGE[$i]}" ]]; then
            _FIXED=$(( _FIXED + 1 + ${#S_AGE[$i]} )) # " age"
        fi
    done
}

# Water-fill: the largest per-field cap L such that Σ min(len, L) over
# _WF_LENS ≤ budget. Short fields keep their full text and hand the leftover
# to long ones — `obsidian` never pays for `dependency-pr-shepherd`. Binary
# search (the sum is monotone in L). Writes `_WF` (0 when nothing fits).
_waterfill() {
    local budget="$1" lo=0 hi=0 mid sum len
    for len in "${_WF_LENS[@]}"; do (( len > hi )) && hi=$len; done
    while (( lo < hi )); do
        mid=$(( (lo + hi + 1) / 2 ))
        sum=0
        for len in "${_WF_LENS[@]}"; do sum=$(( sum + (len < mid ? len : mid) )); done
        if (( sum <= budget )); then lo=$mid; else hi=$(( mid - 1 )); fi
    done
    _WF=$lo
}

# Pick the richest layout that fits `avail` cols, walking a ladder of rungs
# `labels:tasks:ages:floor`. A rung is taken outright when it fits unshrunk;
# otherwise its fields are water-filled and it is taken if the cap reaches
# the rung's floor (`full` = unshrunk only). The last rung always wins.
# with_tasks=false is the pane-border sidebar (labels only, no ages).
# Writes _FIT_LABELS, _FIT_TASKS, _FIT_AGES, _FIT_CAP.
_fit_strip() {
    local avail="$1" with_tasks="$2"
    local -a ladder
    if [[ "$with_tasks" == true ]]; then
        ladder=(
            "full:both:true:full"           # everything, in full
            "short:both:true:$BOTH_FLOOR"   # branch-or-dir · title
            "short:only:true:$AGE_FLOOR"    # title (or label) + age
            "short:only:false:1"            # title (or label) only
        )
    else
        ladder=(
            "full:none:false:full"
            "short:none:false:1"
        )
    fi
    local rung labels tasks ages floor sum len
    for rung in "${ladder[@]}"; do
        IFS=: read -r labels tasks ages floor <<< "$rung"
        _measure "$labels" "$tasks" "$ages"
        sum=0
        for len in "${_WF_LENS[@]}"; do sum=$(( sum + len )); done
        if (( _FIXED + sum <= avail )); then
            _WF=$UNLIMITED
            break
        fi
        [[ "$floor" == full ]] && continue
        _waterfill $(( avail - _FIXED ))
        (( _WF >= floor )) && break
    done
    (( _WF < 1 )) && _WF=1
    _FIT_LABELS=$labels
    _FIT_TASKS=$tasks
    _FIT_AGES=$ages
    _FIT_CAP=$_WF
}

# Load a saved fit (4 values in _FIT_* order) into the _FIT_* globals.
_use_fit() {
    _FIT_LABELS=$1; _FIT_TASKS=$2; _FIT_AGES=$3; _FIT_CAP=$4
}

# Body of tab i under the loaded fit — "idx glyph text" without pads or
# colours — to `_BODY`; its age (or empty) to `_AGE_PART`, kept separate so
# the caller can shade it.
_render_tab() {
    local i="$1" idx=$(( i + 1 )) text
    _tab_fields "$i" "$_FIT_LABELS" "$_FIT_TASKS"
    _trunc "$_F1" "$_FIT_CAP"; text="$_T"
    if [[ -n "$_F2" ]]; then
        _trunc "$_F2" "$_FIT_CAP"; text+=" · $_T"
    fi
    _BODY="${idx}${S_GLYPH[$i]} ${text}"
    _AGE_PART=""
    if [[ "$_FIT_AGES" == true && -n "${S_AGE[$i]}" ]]; then
        _AGE_PART="${S_AGE[$i]}"
    fi
}

# Build the strip with tab P highlighted as current, under the loaded fit.
# Writes `_STRIP` (no $() fork on caller side).
_build_strip() {
    local p_idx="$1" want_clickable="$2"
    local strip="" i state color cur_fg entry age_fmt
    for i in "${!S_NAME[@]}"; do
        state="${S_STATE[$i]}"
        color="${S_COLOR[$i]}"
        _render_tab "$i"
        if (( i == p_idx )); then
            cur_fg='colour16'
            case "$state" in
                idle|dead|starting) cur_fg='colour231' ;;
            esac
            age_fmt=""
            [[ -n "$_AGE_PART" ]] && age_fmt=" #[nobold]${_AGE_PART}#[bold]"
            entry="#[fg=${cur_fg},bg=${color},bold] ${_BODY}${age_fmt} #[default]"
        else
            age_fmt=""
            [[ -n "$_AGE_PART" ]] && age_fmt=" #[fg=${S_DIM[$i]}]${_AGE_PART}"
            entry="#[fg=${color},bg=colour234] ${_BODY}${age_fmt} #[default]"
        fi
        (( i > 0 )) && strip+="$TAB_SEP"
        if [[ "$want_clickable" == true ]]; then
            strip+="#[range=user|${S_NAME[$i]}]${entry}#[norange]"
        else
            strip+="$entry"
        fi
    done
    _STRIP="$strip"
}

# Fit once per variant; every perspective shares the layout. status-right
# renders " <session id> HH:MM " (see lib/tmux.sh), so reserve exactly that.
_reserve=$(( ${#S_NAME[0]} + 8 ))
_fit_strip $(( _AVAIL_WIDTH - _reserve )) true
LEFT_FIT=("$_FIT_LABELS" "$_FIT_TASKS" "$_FIT_AGES" "$_FIT_CAP")
_fit_strip $(( _AVAIL_WIDTH - 2 )) false
SIDE_FIT=("$_FIT_LABELS" "$_FIT_TASKS" "$_FIT_AGES" "$_FIT_CAP")

# Write per-session options. Each session sees itself as current — switch is
# instant because tmux reads the precomputed option. set-option calls are
# chained into as few tmux invocations as possible (tmux's `;` command
# separator) so we pay a couple of fork+execs instead of 2N — but a single
# client→server tmux command is capped at ~16KB (imsg limit: "command too
# long"), and the payload grows ~quadratically with session count (N sessions
# × N tabs per strip). One giant batch silently failed past ~9 sessions,
# leaving every session's options stale or unset. Flush in chunks that stay
# safely under the cap; a session's 2 options may straddle a chunk boundary
# (no atomicity requirement between them).
_BATCH_BUDGET=12288
batch_args=()
batch_len=0

_batch_flush() {
    (( ${#batch_args[@]} > 0 )) || return 0
    am_tmux "${batch_args[@]}" >/dev/null 2>&1 || true
    batch_args=()
    batch_len=0
}

# Append one `set-option -q -t <session> <option> <value>` command, flushing
# first when it would push the packed payload over budget.
_batch_add() {
    local session="$1" option="$2" value="$3"
    # Packed size ≈ argv bytes + per-arg NULs; 48 generously covers
    # "set-option -q -t" and the `;` separator.
    local len=$(( ${#session} + ${#option} + ${#value} + 48 ))
    if (( batch_len > 0 && batch_len + len > _BATCH_BUDGET )); then
        _batch_flush
    fi
    (( ${#batch_args[@]} > 0 )) && batch_args+=(';')
    batch_args+=(set-option -q -t "$session" "$option" "$value")
    batch_len=$(( batch_len + len ))
}

for p_idx in "${!S_NAME[@]}"; do
    p_session="${S_NAME[$p_idx]}"
    _use_fit "${LEFT_FIT[@]}"; _build_strip "$p_idx" true;  status_left="$_STRIP"
    _use_fit "${SIDE_FIT[@]}"; _build_strip "$p_idx" false; sidebar="$_STRIP"

    _batch_add "$p_session" @am_status_left "$status_left"
    _batch_add "$p_session" @am_sidebar "$sidebar"
done
_batch_flush

# Stdout: clickable strip from the perspective of the arg session, only when
# explicitly requested. tmux invocations leave it empty so #() refreshes
# don't clobber the bar.
if $print_mode; then
    target_idx=-1
    for i in "${!S_NAME[@]}"; do
        if [[ "${S_NAME[$i]}" == "$current" ]]; then
            target_idx=$i
            break
        fi
    done
    _use_fit "${LEFT_FIT[@]}"
    if (( target_idx >= 0 )); then
        _build_strip "$target_idx" true
        printf '%s\n' "$_STRIP"
    elif [[ -z "$current" ]]; then
        # No specific session requested — print first session's view so callers
        # still see meaningful output.
        _build_strip 0 true
        printf '%s\n' "$_STRIP"
    fi
fi
