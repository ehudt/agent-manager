#!/usr/bin/env bash
# preview - Fast standalone preview for fzf
# Usage: preview <session_name>

# The sourced libs need bash >= 4.4 (namerefs, ${var@Q}); an older bash
# would fail partway with parse errors. Say so and exit cleanly instead.
if [[ -z "${BASH_VERSINFO:-}" ]] || (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    echo "agent-manager needs bash >= 4.4 (this is ${BASH_VERSION:-unknown})"
    exit 0
fi

set -euo pipefail

session_name="${1:-}"

if [[ -z "$session_name" ]]; then
    echo "No session selected"
    exit 0
fi

# Minimal init — only source utils and tmux (skip registry; use jq directly)
source "$(dirname "${BASH_SOURCE[0]}")/utils.sh"
source "$(dirname "${BASH_SOURCE[0]}")/tmux.sh"

# Check session exists
if ! am_tmux has-session -t "$session_name" 2>/dev/null; then
    echo "Session not found: $session_name"
    exit 0
fi

# Read directory and task from registry in one jq call (avoids sourcing registry.sh)
AM_REGISTRY="${AM_REGISTRY:-${HOME}/.agent-manager/sessions.json}"
directory="" task="" workdir="" agent_type=""
if [[ -f "$AM_REGISTRY" ]]; then
    local_fields=$(jq -r --arg name "$session_name" \
        '.sessions[$name] | [.directory // "", .task // "", .workdir // "", .agent_type // ""] | join("|")' \
        "$AM_REGISTRY" 2>/dev/null || true)
    IFS='|' read -r directory task workdir agent_type <<< "$local_fields"
fi

# This session's conversation id: the sidecar its own hook wrote (ephemeral,
# else durable). The first-message readers open exactly that transcript.
session_id=""
for sid_file in "${AM_STATE_DIR:-/tmp/am-state}/$session_name.sid" \
                "${AM_IDENTITY_DIR:-${HOME}/.agent-manager/identities}/$session_name.sid"; do
    if [[ -f "$sid_file" ]]; then
        IFS= read -r session_id < "$sid_file" 2>/dev/null || true
        [[ -n "$session_id" ]] && break
    fi
done

echo -e "\033[1mSession:\033[0m $session_name"
if [[ -n "$directory" ]]; then
    echo -e "\033[1mDirectory:\033[0m $directory"
fi
if [[ -n "$workdir" ]]; then
    echo -e "\033[1mWorking in:\033[0m $workdir"
fi
if [[ -n "$task" ]]; then
    echo ""
    echo -e "\033[1;36m$task\033[0m"
fi

# Show the first user message of this session's own transcript, if bound
if [[ -n "$directory" && -n "$session_id" ]]; then
    first_msg=""
    case "$agent_type" in
        pi) first_msg=$(pi_first_user_message "$directory" "$session_id" 2>/dev/null || true) ;;
        *)  first_msg=$(claude_first_user_message "$directory" "$session_id" 2>/dev/null || true) ;;
    esac
    if [[ -n "$first_msg" ]]; then
        echo ""
        echo -e "\033[2m$first_msg\033[0m"
    fi
fi
echo ""

# Capture terminal output from the agent pane (top pane)
output=$(tmux_capture_pane "$session_name:.{top}" 50 || tmux_capture_pane "$session_name" 50)

if [[ -n "$output" ]]; then
    # Strip trailing blank lines (capture-pane pads with empties)
    echo "$output" | sed -e :a -e '/^[[:space:]]*$/{' -e '$d' -e N -e ba -e '}'
else
    echo "(Unable to capture)"
fi
