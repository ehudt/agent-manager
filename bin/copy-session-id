#!/usr/bin/env bash
# Copy the session id (the am-XXXXXX tmux session name, what `am id` prints)
# to the clipboard. Bound to prefix+y by the generated tmux config.
# Usage: copy-session-id <client> <session>

set -euo pipefail

client="${1:-}"
session="${2:-}"
[[ -n "$client" && -n "$session" ]] || exit 1

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
    script_path="$(readlink "$script_path")"
    [[ "$script_path" != /* ]] && script_path="$script_dir/$script_path"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

source "$repo_dir/lib/utils.sh"
source "$repo_dir/lib/tmux.sh"

# The tmux buffer (prefix+] pastes it); -w also hands it to the outer
# terminal's clipboard over OSC 52, which is the only route over ssh.
am_tmux set-buffer -w -t "$client" -- "$session" 2>/dev/null || true

# A local clipboard tool, when there is one. xclip and wl-copy fork a child
# that keeps the selection alive; with its output on /dev/null run-shell does
# not wait for it.
_copy_with() {
    command -v "$1" >/dev/null 2>&1 || return 1
    printf '%s' "$session" | "$@" >/dev/null 2>&1
}
if _copy_with pbcopy || _copy_with wl-copy \
        || _copy_with xclip -selection clipboard || _copy_with xsel --clipboard --input; then
    am_tmux display-message -c "$client" "Copied $session" 2>/dev/null || true
else
    am_tmux display-message -c "$client" "Copied $session to the tmux buffer (prefix+] pastes it)" 2>/dev/null || true
fi
