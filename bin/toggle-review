#!/usr/bin/env bash
# Toggle the review pane of an am session: first use creates it via
# `am review` (bin/am-review beside the agent, showing the changes since the
# review baseline); after that it hides (break-pane into the hidden _amreview
# window) or shows (join-pane back) the same pane, so the TUI's selection and
# scroll position survive. Bound to prefix+v by the generated tmux config,
# which passes #{session_name}.

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
    script_path="$(readlink "$script_path")"
    [[ "$script_path" != /* ]] && script_path="$script_dir/$script_path"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

source "$repo_dir/lib/utils.sh"
source "$repo_dir/lib/tmux.sh"

session="${1:-}"
if [[ -z "$session" ]]; then
    session=$(am_tmux display-message -p '#{session_name}' 2>/dev/null || true)
fi
[[ "$session" == "${AM_SESSION_PREFIX}"* ]] || exit 0

case "$(tmux_review_pane_state "$session")" in
    open) tmux_review_pane_hide "$session" ;;
    hidden) tmux_review_pane_show "$session" ;;
    *)
        if ! "$repo_dir/am" review "$session" 2>/tmp/am-review-toggle.$$; then
            # Surface the reason (not a repo, binary missing) in the tmux message line.
            msg=$(tr '\n' ' ' < /tmp/am-review-toggle.$$ | sed -E 's/\x1b\[[0-9;]*m//g')
            rm -f /tmp/am-review-toggle.$$
            am_tmux display-message "am review: ${msg:-failed}"
            exit 0
        fi
        rm -f /tmp/am-review-toggle.$$
        ;;
esac
