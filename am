#!/usr/bin/env bash
# am - Agent Manager
# A CLI tool for managing multiple AI coding agent sessions

# 4.4: namerefs (local -n, 4.3) across lib/state.sh and ${var@Q} quoting
# (4.4) in lib/agents.sh — the latter is a parse-time error on older bash.
if [[ -z "${BASH_VERSINFO:-}" ]] || (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    echo "am requires bash >= 4.4 (current: ${BASH_VERSION:-unknown})." >&2
    echo "  macOS: brew install bash   (ships 3.2; the new bash goes first in PATH)" >&2
    echo "  Linux: install bash 4.4+ from your distro" >&2
    echo "Then open a new terminal so '/usr/bin/env bash' resolves to it." >&2
    exit 1
fi

set -euo pipefail

# Version
AM_VERSION="0.40.0"

# Determine script directory (resolve symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    AM_SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$AM_SCRIPT_DIR/$SOURCE"
done
AM_SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
AM_LIB_DIR="$AM_SCRIPT_DIR/lib"

# Usage information (no dependencies needed)
usage() {
    echo "am - Agent Manager v$AM_VERSION"
    cat <<'EOF'

Manage multiple AI coding agent sessions with an interactive fzf interface.

USAGE:
    am [command] [options]
    am new [options] <directory> [-- extra-args...]

COMMANDS:
    (default)           Open interactive session browser
    list                List all sessions
    new                 Create a new agent session
    send                Send a prompt to a running session
    peek                Show or follow another session's pane output
    attach              Attach to a session by name (exact, prefix, or fuzzy)
    shell               Toggle a session's shell panel (open on first use, then hide/show)
    id                  Print the name of the am session you are inside
    cd                  Record where the current session works now (label + branch follow)
    owner               Print the live session working in a directory (for tools reclaiming checkouts)
    diff                Show what a session changed since you last reviewed it (--ack, --list)
    review              Toggle the live review pane beside the agent (prefix+v)
    kill                Kill a session (--all, --state <list>)
    config              Show or change saved defaults
    preset              Save and list launch presets for 'new -p'
    info                Show a session's registry metadata
    status              Show detailed session info
    doctor              Print every input behind a session's state (debugging)
    log                 Show the events log: launches, kills, sends, and swallowed failures
    wait                Block until one or more sessions reach a target state
    done                (inside a session) Record a result summary for the dispatcher
    result              Read the summary a session recorded with 'done'
    interrupt           Send Ctrl-C to an agent pane
    restore             Browse and resume a closed agent session
    install             First-time setup (deps, config, skills, PATH, hooks); --dry-run previews
    uninstall           Reverse install (PATH, shell rc, hooks, skills); --purge also removes ~/.agent-manager
    completions         Print the bash or zsh completion script (am install wires it in)
    help                Show this help message

OPTIONS FOR 'list':
    --json          Output as JSON
    --state <list>  Only sessions in these states (comma-separated)

OPTIONS FOR 'new':
    -t, --type      Agent type: claude, codex, cursor, pi, opencode (saved default applies)
    -p, --preset    Apply a saved preset; explicit flags win (see 'am preset')
    -d, --dir      Directory (can also be positional arg)
    @spec           Directory from the configured dir_provider (am new @48351;
                    bare @ for the provider's default)
    --shell         Open the shell panel at launch (default: agent-only)
    --no-shell      Start agent-only even if shell_pane is enabled by default
    --detach        Create the session without attaching
    --print-session Print the created session name to stdout
    --              Pass remaining args to agent (e.g., -- --resume)

OPTIONS FOR 'send':
    Read prompt text from argv or stdin and inject it into the agent pane now;
    a running agent steers on it or queues it (its own setting). Refused only
    when a dialog is up or the agent is still starting (exit 4), or it has
    exited and the text would run in a shell (exit 2), unless one of:
    --wait          Deliver at the turn boundary: block until ready (or background)
    --queue         Same, detached: a helper sends when ready; outcome in
                    $AM_DIR/queue.log, undelivered prompt kept as queue/<file>.failed
    --force, -f     Send regardless of state
    --timeout N     Seconds before giving up; 0 = none (--wait: 600, --queue: 0)

OPTIONS FOR 'peek':
    --pane <name>   Pane to inspect: agent|shell (default: agent)
    --follow, -f    Stream output continuously
    --lines N       Lines of pane content to include, from the end (default: 50)
    --history       Read the streamed shell.log scrollback instead of the viewport
    --grep <re>     With --history: filter lines (grep -E) before --lines

OPTIONS FOR 'diff':
    Diff from the session's review baseline (a checkpoint kept in its repo:
    the working copy at launch, then whatever you acknowledged) to the
    working copy now, through your git pager. Session defaults to the one
    you are inside. The tab shows the pending size as Δ<files> +<add> −<del>.
    --ack               Mark the working copy as reviewed (new baseline)
    --reset             Baseline back to the launch checkpoint
    --checkpoint <id>   One-off diff from that checkpoint
    --list, -l          List checkpoints (launch / ack / branch / head)
    --stat, -- <args>   Forwarded to git diff

OPTIONS FOR 'wait':
    --state <list>  Comma-separated target states (default: ready,waiting_user,idle,dead)
    --timeout N     Seconds before giving up (default: 600; exit 3 on timeout)
    --json          Print final state as JSON on exit
    --any | --all   With several sessions: first to arrive, or every one (default)

OPTIONS FOR 'status':
    --json          Output as JSON (single session or array of all sessions)

OPTIONS FOR 'doctor':
    --capture       Also write a tarball of the report and raw state files

OPTIONS FOR 'log':
    -n N            Newest N lines (default 50); a session argument filters to it
    --grep ERE      Keep matching lines only (e.g. 'fail|refused')
    -f              Follow: keep printing new lines

KEYBINDINGS (interactive browser):
    Enter           Attach, restore, or launch the selected row
    Tab             Agent for New session rows (Shift-Tab: back)
    Ctrl-N          Jump to New session (on a session: a new one in its dir)
    Ctrl-X          Kill selected active session
    Ctrl-R          Refresh session list
    Ctrl-P          Toggle the preview pane
    Ctrl-H          Jump to the first inactive (restorable) session
    type            Filter sessions and New session rows (/ ~ . path, @spec)
    ?               Show inline help

KEYBINDINGS (inside tmux session):
    Prefix + 1-9    Jump to the Nth session tab
    Prefix + a      Switch to last am session
    Prefix + ←/→    Previous / next session tab
    Prefix + n      Open the browser popup on New session
    Prefix + s      Open am browser popup (Prefix + h does the same)
    Prefix + x      Kill the current am session
    Prefix + d      Detach from session
    Prefix + `      Toggle the shell panel (open on first use, then hide/show)
    Prefix Up/Down  Switch panes (when the shell panel is open)
    Prefix + [ / ]  Copy mode / paste
    mouse click     Click a tab in the bottom bar to switch to it
    :am             Open am browser (tmux command)

EXAMPLES:
    am                              # Open interactive browser
    am new                          # Browser, cursor on New session
    am new ~/code/proj              # New session in specific directory
    am new -t codex ~/code/proj     # New codex session
    am new -t cursor ~/code/proj    # New Cursor Agent session
    am new @48351                  # Directory from the provider (needs dir_provider)
    printf 'Fix auth bug\n' | am new --detach ~/code/proj
    printf 'Run the test suite\n' | am send am-abc123
    am new -p review @48351         # Saved preset (am preset save review @ -- --model opus)
    am wait --any am-abc123 am-def456   # First worker to pause
    am doctor am-abc123             # Why does the tab show that state?
    am log --grep 'fail|refused'    # What went wrong recently? (am log am-abc123 for one session)
    am peek am-abc123
    am peek --pane shell --follow am-abc123
    am send "$(am id)" "continue"   # Address the session you are in
    am attach am-abc123             # Attach to session by name
    am kill am-abc123               # Kill specific session

DEPENDENCIES:
    tmux >= 3.2, fzf >= 0.40, jq, git

CONFIGURATION:
    Sessions stored in: ~/.agent-manager/
    Agent sessions run on the dedicated tmux server/socket: agent-manager
    See README for tmux setup details.
EOF
}

# Handle help/version before loading libs (no deps needed)
case "${1:-}" in
    help|--help|-h)
        usage
        exit 0
        ;;
    version|--version|-v)
        echo "am version $AM_VERSION"
        exit 0
        ;;
    completions)
        # Printed at every shell start from the rc block, so it stays on the
        # no-libs path: the completion file with the agent types (manifest
        # order) filled in.
        case "${2:-}" in
            bash|zsh)
                _am_types=$(awk -F. '/^[a-z][a-z0-9_-]*\./ { print $1 }' "$AM_LIB_DIR/agents.manifest" | awk '!seen[$0]++' | tr '\n' ' ')
                sed "s/@AGENT_TYPES@/${_am_types% }/" "$AM_SCRIPT_DIR/completions/am.$2"
                exit 0
                ;;
            *)
                echo "Usage: am completions bash|zsh" >&2
                echo "  bash: eval \"\$(am completions bash)\"  in ~/.bashrc" >&2
                echo "  zsh:  eval \"\$(am completions zsh)\"   in ~/.zshrc (am install adds it)" >&2
                exit 1
                ;;
        esac
        ;;
esac

# Export AM_LIB_DIR so libs skip dirname subprocesses
export AM_LIB_DIR

# Source core libraries (needed by all commands)
source "$AM_LIB_DIR/utils.sh"
source "$AM_LIB_DIR/config.sh"
source "$AM_LIB_DIR/tmux.sh"
source "$AM_LIB_DIR/registry.sh"

# Fast path: list-internal is called on every browser reload — compiled Go binary
if [[ "${1:-}" == "list-internal" ]]; then
    # Require both executable bit and non-zero size. test_install's fake `go`
    # writes a zero-byte stub at bin/am-list-internal; an exec on that returns
    # empty output and breaks parallel test workers that share the project tree.
    if [[ -x "$AM_SCRIPT_DIR/bin/am-list-internal" && -s "$AM_SCRIPT_DIR/bin/am-list-internal" ]]; then
        exec "$AM_SCRIPT_DIR/bin/am-list-internal"
    fi
    echo "Error: bin/am-list-internal is not built. Run 'make' (or 'am install') to build it." >&2
    exit 1
fi

# Source remaining libraries for interactive commands
source "$AM_LIB_DIR/agents.sh"
source "$AM_LIB_DIR/fzf.sh"
source "$AM_LIB_DIR/presets.sh"

# Lazy-loaders: state.sh and doctor.sh are deferred for faster startup
_ensure_state() { [[ "$(type -t agent_get_state)" == "function" ]] || source "$AM_LIB_DIR/state.sh"; }
_ensure_doctor() { _ensure_state; [[ "$(type -t doctor_main)" == "function" ]] || source "$AM_LIB_DIR/doctor.sh"; }
_ensure_review() { [[ "$(type -t review_diff_main)" == "function" ]] || source "$AM_LIB_DIR/review.sh"; }

# Command: diff — what the agent changed since the review baseline
# (lib/review.sh). Session from the argument, else the pane the caller is in.
cmd_diff() {
    _ensure_review
    review_diff_main "$@"
}

# Command: list (plain text or JSON)
cmd_list() {
    local json=false
    local states=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json|-j)
                json=true
                shift
                ;;
            --state|-s)
                states="${2:-}"
                shift 2
                ;;
            --state=*)
                states="${1#--state=}"
                shift
                ;;
            -h|--help)
                echo "Usage: am list [--json] [--state <s1,s2,...>]"
                echo "  --state   Only sessions whose state is in the list"
                echo "            (starting,running,ready,waiting_user,background,idle,unknown,dead)"
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    if [[ -n "$states" ]]; then
        AM_LIST_STATE_FILTER="$states"
        export AM_LIST_STATE_FILTER
    fi
    if $json; then
        fzf_list_json
    else
        fzf_list_simple
    fi
}

# Command: browse (interactive fzf session picker — default when no args)
cmd_browse() {
    _install_refresh_if_stale
    recovery_start_for_browser

    local result
    result=$(fzf_main)
    _browse_result "$result"
}

# Act on one am-browse output line: attach a session, restore or retry one,
# or launch a new one. Shared by the browser and `am new` with no arguments,
# whose list offers the same rows.
# Usage: _browse_result <line>
_browse_result() {
    local result="$1"
    if [[ "$result" == $'__RESTORE__\x1f'* ]]; then
        # Parse: __RESTORE__<US>directory<US>session_id<US>agent_type
        local directory session_id restore_agent
        IFS=$'\x1f' read -r _tag directory session_id restore_agent <<< "$result"
        local rc=0
        cmd_restore_internal "$directory" "$session_id" "${restore_agent:-claude}" || rc=$?
        if (( rc != 0 )); then
            # 3 = the user declined the relocation prompt: nothing to read.
            (( rc == 3 )) || _launch_fail_hold restore
            return 1
        fi
    elif [[ "$result" == $'__NEW_SESSION__\x1f'* ]]; then
        # Parse: __NEW_SESSION__<US>directory<US>agent_type<US>flags
        local directory agent_type flags
        IFS=$'\x1f' read -r _tag directory agent_type flags <<< "$result"

        # Create new session from the New session row
        # shellcheck disable=SC2086
        cmd_new_internal "$directory" "$agent_type" $flags
    elif [[ "$result" == $'__RETRY_RECOVERY__\x1f'* ]]; then
        local recovery_id="${result#*$'\x1f'}"
        recovery_desired_retry "$recovery_id"
        cmd_browse
    elif [[ "$result" == $'__FORGET_RECOVERY__\x1f'* ]]; then
        local recovery_id="${result#*$'\x1f'}"
        recovery_desired_remove "$recovery_id"
        cmd_browse
    elif [[ -n "$result" ]]; then
        # Attach to selected session. The session set is unchanged, so the
        # precomputed @am_status_left option (written when sessions were
        # created/killed) is already correct — no sync status-bar call here.
        # client-session-changed fires status-bar in the background to keep
        # state glyphs current.
        tmux_attach "$result"
    fi
}

# Internal worker used by the interactive browser's progressive reboot recovery.
cmd_recover_open() {
    case "${1:-}" in
        --worker|"")
            recovery_run
            ;;
        *)
            log_error "Unknown recover-open option: $1"
            return 1
            ;;
    esac
}

# Internal: create session from form data (called from fzf_main)
# Usage: cmd_new_internal <directory> [agent_type] [task] [flags...]
# The new-session popup (prefix+n, Ctrl-N in the browser) runs under
# `display-popup -E`: tmux closes it the moment am exits, so a failure after
# the form — the `@spec` provider, the launch itself — is gone before it can
# be read. Observed 2026-09-15: a wp checkout died on a submodule and the
# user saw "the popup closed and no session was created". Hold the popup on
# a form-path failure until a key is pressed; scripted callers (no tty) never
# wait, and AM_LAUNCH_HOLD=0 disables it. Restoring an inactive row from the
# browser fails the same way (source restore): a released wp checkout made
# Enter look like a no-op, the "Directory no longer exists" line gone with
# the popup (2026-10-01).
_launch_fail_hold() {
    local what
    case "${1:-}" in
        form) what="Session not created" ;;
        restore) what="Session not restored" ;;
        *) return 0 ;;
    esac
    [[ "${AM_LAUNCH_HOLD:-1}" != 0 ]] || return 0
    [[ -t 0 && -r /dev/tty ]] || return 0
    printf '\n%s\n' "$what (details above; also in 'am log'). Press any key to close." >&2
    read -rsn1 </dev/tty || true
}

# A `@spec` names a branch or PR, and the provider answers with whichever
# pooled copy holds it — the copy a live session is already working in, when
# there is one. Two agents in one checkout is almost never what was meant;
# refuse with the way around (attach, or name the path, which is never
# checked). Usage: _dir_free_of_live_session <dir> <spec> <source>
_dir_free_of_live_session() {
    local dir="$1" spec="$2" source="${3:-cli}" busy
    busy=$(agent_dir_live_session "$dir")
    [[ -z "$busy" ]] && return 0
    am_event launch.fail - "source=$source" "dir=$dir" "spec=$spec" "reason=dir_busy" "busy=$busy"
    log_error "$spec resolved to $dir, where a live session is already working: $busy"
    echo "Attach it with 'am attach $busy', or pass the directory itself to start a second agent there." >&2
    return 1
}

cmd_new_internal() {
    local directory="$1"
    local agent_type="${2:-$(am_default_agent)}"
    shift 2 2>/dev/null || shift $#
    local agent_args=("$@")

    # The browser's values arrive raw, exactly as in cmd_new's interactive
    # branch: a preset row is a --preset=<name> flag for us (its args and
    # shell flag merge here), and a `@spec` directory still has to be
    # resolved by the provider. Until 0.37 this path launched with both
    # untouched, so Ctrl-N + `@<PR>` died on "Directory does not exist: @…".
    local _flag _kept=() _form_preset=""
    for _flag in "${agent_args[@]}"; do
        case "$_flag" in
            --preset=*) _form_preset="${_flag#--preset=}" ;;
            *) _kept+=("$_flag") ;;
        esac
    done
    agent_args=("${_kept[@]}")
    if [[ -n "$_form_preset" ]]; then
        _cmd_new_apply_preset "$_form_preset" false || return 1
    fi
    if am_dir_is_spec "$directory"; then
        local spec="$directory"
        if ! directory=$(agent_dir_resolve "$directory"); then
            _launch_fail_hold form
            return 1
        fi
        if ! _dir_free_of_live_session "$directory" "$spec" form; then
            _launch_fail_hold form
            return 1
        fi
    fi

    local session_name
    _AM_LAUNCH_SOURCE=form
    if ! session_name=$(agent_launch "$directory" "$agent_type" "" "${agent_args[@]}"); then
        _AM_LAUNCH_SOURCE=""
        _launch_fail_hold form
        return 1
    fi
    _AM_LAUNCH_SOURCE=""

    if [[ -n "$session_name" ]]; then
        tmux_attach "$session_name"
    fi
}

# What to do when a closed session's checkout has moved on (<problem> from
# am_checkout_check: `missing`, or `branch <found>`). Prints `fresh` (resume
# in a new checkout of <branch> from the dir_provider) or `here` (resume in
# <directory> as it is; not offered for a missing directory). Returns 1 when
# neither is possible or AM_RESTORE_ON_MISMATCH says fail, 3 when the user
# declined. AM_RESTORE_ON_MISMATCH presets the answer for scripts
# (ask|fresh|here|fail, default ask); `ask` without a tty fails with the
# options spelled out.
# Usage: _restore_relocation_choice <directory> <branch> <problem>
_restore_relocation_choice() {
    local directory="$1" branch="$2" problem="$3"
    local mode="${AM_RESTORE_ON_MISMATCH:-ask}"
    local can_here=true can_fresh=true no_fresh=""
    [[ "$problem" == missing ]] && can_here=false
    if [[ -z "$branch" ]]; then
        can_fresh=false; no_fresh="the session has no recorded branch"
    elif [[ -z "$(am_dir_provider)" ]]; then
        can_fresh=false; no_fresh="no dir_provider is configured (am config set dir_provider wp)"
    fi
    local provider
    provider=$(am_dir_provider)

    case "$mode" in
        fresh)
            if $can_fresh; then echo fresh; return 0; fi
            log_error "Cannot resume in a fresh checkout: $no_fresh"
            return 1
            ;;
        here)
            if $can_here; then echo here; return 0; fi
            log_error "Cannot resume in place: the directory is gone"
            return 1
            ;;
        fail) return 1 ;;
        ask) ;;
        *)
            log_error "AM_RESTORE_ON_MISMATCH=$mode: expected ask, fresh, here, or fail"
            return 1
            ;;
    esac

    if [[ ! -t 0 || ! -r /dev/tty ]]; then
        # Scripted caller: no prompt, but say what would have been offered.
        $can_fresh && echo "  AM_RESTORE_ON_MISMATCH=fresh  resume in a fresh checkout of $branch (${provider} resolve $branch)" >&2
        $can_here && echo "  AM_RESTORE_ON_MISMATCH=here   resume in $directory as it is" >&2
        if ! $can_fresh; then
            echo "  No fresh checkout possible: $no_fresh." >&2
            $can_here || echo "  The conversation is keyed to that path; recreate it (even empty: mkdir -p '$directory') and restore again." >&2
        fi
        return 1
    fi

    {
        echo ""
        $can_fresh && echo "  [f] resume in a fresh checkout of $branch (${provider} resolve $branch)"
        $can_here && echo "  [h] resume here anyway, in $directory as it is"
        if ! $can_fresh; then
            echo "  No fresh checkout possible: $no_fresh."
            $can_here || echo "  To resume, recreate the directory (even empty: mkdir -p '$directory') and restore again."
        fi
        echo "  [q] cancel"
        echo ""
    } >&2
    local key=""
    read -rsn1 key </dev/tty || true
    case "$key" in
        f|F) $can_fresh && { echo fresh; return 0; } ;;
        h|H) $can_here && { echo here; return 0; } ;;
    esac
    return 3
}

# The first prompt of a conversation resumed in another checkout: the history
# is full of absolute paths under the old directory, and the agent will reuse
# them unless told where it is now. When the new copy's HEAD differs from the
# one the session ended on, say so — unpushed work from the removed copy is
# not here, and the agent believes it is.
# Usage: _restore_move_note <old_dir> <new_dir> <branch> <problem> <old_sha>
_restore_move_note() {
    local old_dir="$1" new_dir="$2" branch="$3" problem="$4" old_sha="$5"
    local note
    if [[ "$new_dir" == "$old_dir" ]]; then
        note="This conversation was resumed in a fresh checkout of branch $branch at $new_dir. The copy it previously ran in at this path was removed and re-created, so files and commits from the earlier copy exist here only if they were pushed."
    else
        local was
        if [[ "$problem" == missing ]]; then
            was="which no longer exists"
        else
            was="which now has another branch checked out and may belong to other work"
        fi
        note="This conversation was resumed in $new_dir (branch $branch, a fresh checkout). It previously ran in $old_dir, $was. Work only under $new_dir; do not read or edit paths under $old_dir."
    fi
    local new_sha
    new_sha=$(git -C "$new_dir" rev-parse HEAD 2>/dev/null || true)
    if [[ -n "$old_sha" && -n "$new_sha" && "$old_sha" != "$new_sha" ]]; then
        note+=" HEAD here is ${new_sha:0:12}; the session ended on ${old_sha:0:12}, so commits or edits made in the old copy that were never pushed are not in this checkout — verify before relying on them."
    fi
    printf '%s' "$note"
}

# Internal: restore a session by launching an agent with resume/session args
# Usage: cmd_restore_internal <directory> <session_id> [agent_type]
# <directory> is the launch directory the session ran in. When it is gone or
# holds another branch (released / re-allocated pooled copy), the user is
# offered a fresh checkout of the recorded branch through the dir_provider
# (see _restore_relocation_choice); the conversation itself does not depend
# on the directory (Claude resumes by id from anywhere and keeps writing the
# original transcript — verified on 2.1.286, live lab s8), only am's
# bookkeeping does, and that is pre-seeded here. Exit 1 on failure, 3 when
# the user declined the relocation prompt.
cmd_restore_internal() {
    local directory="$1"
    local session_id="$2"
    local agent_type="${3:-claude}"

    local resume_args=()
    while IFS= read -r _arg; do
        resume_args+=("$_arg")
    done < <(agent_resume_args "$agent_type" "$session_id")
    if [[ ${#resume_args[@]} -eq 0 ]]; then
        am_event restore.fail - "sid=$session_id" "agent=$agent_type" "dir=$directory" "reason=no_resume_form"
        log_error "Agent type '$agent_type' has no resume form; cannot restore"
        return 1
    fi

    # The branch, HEAD and transcript the session closed on (agent_kill
    # records them; older rows carry only the launch branch).
    # Per line (fromjson?): the GC keeps lines this version cannot parse,
    # and a whole-file slurp would fail on one of them and skip the check.
    # `fence` is the relocation fence the closed session carried (newlines
    # travel as RS so the row stays one line).
    local branch="" head_sha="" old_transcript="" prev_fence=""
    if [[ -f "$AM_SESSIONS_LOG" ]]; then
        IFS=$'\x1f' read -r branch head_sha old_transcript prev_fence < <(jq -Rr --arg sid "$session_id" \
            'fromjson? | select(.session_id == $sid) | [(.branch // ""), (.head_sha // ""), (.transcript_path // ""), (.fence // "" | tostring | gsub("\n"; "\u001e"))] | join("\u001f")' \
            "$AM_SESSIONS_LOG" 2>/dev/null | tail -n1 || true)
        prev_fence="${prev_fence//$'\x1e'/$'\n'}"
    fi
    # A pre-0.38 row closed on a detached HEAD recorded the sha as its
    # branch: not a branch to check out or judge.
    [[ "$branch" =~ ^[0-9a-f]{8}$ ]] && branch=""

    local launch_dir="$directory" relocated=false problem=""
    problem=$(am_checkout_check "$directory" "$branch") || true
    if [[ -n "$problem" ]]; then
        local reason=dir_missing
        if [[ "$problem" == missing ]]; then
            log_error "Directory no longer exists: $directory"
        else
            reason=branch_changed
            log_error "Checkout changed: $directory is on ${problem#branch }, the session ran on $branch"
        fi
        local choice rc=0
        choice=$(_restore_relocation_choice "$directory" "$branch" "$problem") || rc=$?
        if (( rc != 0 )); then
            [[ $rc -eq 3 ]] && reason=declined
            am_event restore.fail - "sid=$session_id" "agent=$agent_type" "dir=$directory" "reason=$reason" "branch=$branch"
            (( rc == 3 )) && log_info "Restore cancelled"
            return $rc
        fi
        if [[ "$choice" == fresh ]]; then
            if ! launch_dir=$(agent_dir_resolve "@$branch"); then
                am_event restore.fail - "sid=$session_id" "agent=$agent_type" "dir=$directory" "reason=resolve_failed" "branch=$branch"
                return 1
            fi
            # The registry directory is abspath'd at launch; the provider's
            # output may carry a trailing slash, so normalize before the
            # same-path comparisons below (a slot re-allocated under the old
            # path must not fence the directory the session now works in).
            launch_dir=$(abspath "$launch_dir")
            local busy
            busy=$(agent_dir_live_session "$launch_dir")
            if [[ -n "$busy" ]]; then
                am_event restore.fail - "sid=$session_id" "agent=$agent_type" "dir=$launch_dir" "reason=dir_busy" "busy=$busy"
                log_error "A live session already works in $launch_dir: $busy (am attach $busy). Not resuming a second agent there."
                return 1
            fi
            # A fresh checkout is a relocation even under the old path (a
            # pool slot re-allocated to the same place): the agent still
            # needs the move note, and the old copy's review refs are gone.
            relocated=true
        fi
    fi

    # Relocation fence for the state hook (`<old>TAB<new>` lines, see
    # lib/hooks/state-hook.sh): the directories this conversation no longer
    # owns. Lines from earlier moves carry over — the transcript still names
    # those paths — except one for the directory it resumes in (or a parent
    # of it: the hook matches `<old>/…`, so fencing a parent would deny every
    # call), which is back in use (a pool slot released and re-allocated to
    # this branch).
    local fence="" fline fold
    while IFS= read -r fline; do
        fold="${fline%%$'\t'*}"
        [[ -n "$fold" && "$fold" != "$launch_dir" && "$launch_dir" != "$fold/"* && "$fold" != "$directory" ]] || continue
        fence+="${fence:+$'\n'}$fline"
    done <<< "$prev_fence"
    if $relocated && [[ "$launch_dir" != "$directory" && "$launch_dir" != "$directory/"* ]]; then
        fence+="${fence:+$'\n'}$directory"$'\t'"$launch_dir"
    fi

    local session_name
    if $relocated; then
        _AM_LAUNCH_PROMPT=$(_restore_move_note "$directory" "$launch_dir" "$branch" "$problem" "$head_sha")
    fi
    _AM_LAUNCH_FENCE="$fence"
    _AM_LAUNCH_SOURCE=restore
    session_name=$(agent_launch "$launch_dir" "$agent_type" "" "${resume_args[@]}")
    _AM_LAUNCH_SOURCE=""
    _AM_LAUNCH_PROMPT=""
    _AM_LAUNCH_FENCE=""

    if [[ -z "$session_name" ]]; then
        # agent_launch logged the launch.fail line with the reason.
        am_event restore.fail - "sid=$session_id" "agent=$agent_type" "dir=$launch_dir" "reason=launch_failed"
        return 1
    fi
    if $relocated; then
        am_event restore "$session_name" "sid=$session_id" "agent=$agent_type" "dir=$launch_dir" "relocated_from=$directory" "branch=$branch"
    else
        am_event restore "$session_name" "sid=$session_id" "agent=$agent_type" "dir=$directory"
    fi

    # Pre-seed the resumed conversation id so the entry never needs the
    # directory-scan guess; the sidecar-authoritative scan corrects it if
    # the agent forks the resume to a new id.
    sessions_log_update "$session_name" "session_id" "$session_id"
    # The fence goes on the row now, not only at kill: the sidecar lives in
    # /tmp, so a crash or reboot before agent_kill would otherwise drop it
    # and the next restore (or reboot recovery) would resume unfenced.
    [[ -n "$fence" ]] && sessions_log_update "$session_name" "fence" "$fence"
    local transcript=""
    if $relocated; then
        # The transcript stays in the old directory's store, which the new
        # row's directory no longer points at: record where it is now, so
        # the row stays identified and restorable even if this session is
        # closed before its first hook event (which would record the same).
        transcript=$(am_core transcript-path "$agent_type" "$directory" "$session_id" "$old_transcript" 2>/dev/null || true)
        # transcript-path falls back to the standard path whether or not
        # it exists; only a real file is worth recording.
        [[ -f "$transcript" ]] || transcript=""
        [[ -n "$transcript" ]] && sessions_log_update "$session_name" "transcript_path" "$transcript"
    fi
    recovery_desired_identity "$session_name" "$session_id" "$transcript" "resume"
    if ! $relocated; then
        # The closed session's review checkpoints continue under the new
        # name. A relocated session starts a fresh chain: its refs live in
        # the old repository.
        local previous
        previous=$(jq -rs --arg sid "$session_id" --arg me "$session_name" \
            '[.[] | select(.session_id == $sid and .session_name != $me)] | last | .session_name // empty' \
            "$AM_SESSIONS_LOG" 2>/dev/null || true)
        if [[ -n "$previous" ]]; then
            am_core review-adopt "$previous" "$session_name" "$directory" >/dev/null 2>&1 || true
        fi
    fi
    tmux_attach "$session_name"
}

# Command: restore (browse and resume a closed session)
cmd_restore() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am restore

Browse recently closed Claude, Codex, Cursor, pi, and opencode sessions and resume one.
Shows pane snapshots in the preview panel for visual recall.

Sessions are available as long as their conversation file exists.

A row marked "⚠ dir gone" or "⚠ on <branch>" ran in a checkout that was
since removed or switched to another branch (a released pooled copy). Enter
then offers [f] a fresh checkout of the session's branch through the
configured dir_provider, [h] resuming in place (when the directory exists),
or [q] cancel. AM_RESTORE_ON_MISMATCH=fresh|here|fail presets the answer
for scripts (default: ask).
EOF
        return 0
    fi

    local result
    if ! result=$(fzf_restore_picker); then
        return 0
    fi

    if [[ "$result" == $'__RESTORE__\x1f'* ]]; then
        local directory session_id restore_agent
        IFS=$'\x1f' read -r _tag directory session_id restore_agent <<< "$result"
        local rc=0
        cmd_restore_internal "$directory" "$session_id" "${restore_agent:-claude}" || rc=$?
        # Declining the relocation prompt is a cancel, like leaving the picker.
        (( rc == 3 )) && return 0
        return $rc
    fi
}

# Prompt text from argv (first, non-empty arg) or stdin. The text is pasted
# into a terminal, where C0 control characters and DEL act as keystrokes (ESC
# starts a key sequence, ^C interrupts), so all of them except newline and tab
# are dropped. LC_ALL=C makes tr byte-oriented, which leaves UTF-8 intact.
read_prompt_input() {
    if [[ $# -gt 0 && -n "$1" ]]; then
        printf '%s' "$1"
    elif [[ ! -t 0 ]]; then
        cat
    fi | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}

# Command: new
# Apply a saved preset to cmd_new's locals (dynamic scope). With fill=true the
# preset supplies directory/agent where the CLI gave none (the directory may be
# a `@spec`); the browser path passes fill=false because its preset row already
# carries those fields. Agent args and the shell flag are always merged: preset
# args first, CLI args after.
# Usage: _cmd_new_apply_preset <name> <fill:true|false>
_cmd_new_apply_preset() {
    local pname="$1" fill="$2" v
    if ! am_preset_get "$pname" >/dev/null 2>&1; then
        log_error "No such preset: $pname (see 'am preset list')"
        return 1
    fi
    if [[ "$fill" == true ]]; then
        v=$(am_preset_field "$pname" agent)
        [[ -n "$v" && -z "$agent_type" ]] && agent_type="$v"
        if [[ "$dir_given" == false ]]; then
            v=$(am_preset_field "$pname" directory)
            if [[ -n "$v" ]]; then
                directory="$v"; dir_given=true
            fi
        fi
    fi
    local -a pargs=()
    mapfile -t pargs < <(am_preset_field "$pname" args)
    local has_shell=false a
    for a in "${agent_args[@]}"; do
        [[ "$a" == "--shell" || "$a" == "--no-shell" ]] && has_shell=true
    done
    if [[ "$(am_preset_field "$pname" shell)" == "true" && "$has_shell" == false ]]; then
        pargs=("--shell" "${pargs[@]}")
    fi
    agent_args=("${pargs[@]}" "${agent_args[@]}")
    return 0
}

cmd_new() {
    local directory=""
    local dir_given=false
    local agent_type=""
    local agent_args=()
    local attach_session=true
    local print_session=false
    local initial_prompt=""
    local preset_name=""
    local launch_source=cli

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--type)
                agent_type="$2"
                shift 2
                ;;
            -p|--preset)
                preset_name="${2:-}"
                shift 2
                ;;
            --preset=*)
                preset_name="${1#--preset=}"
                shift
                ;;
            -d|--dir)
                directory="$2"
                dir_given=true
                shift 2
                ;;
            --shell)
                agent_args+=("--shell")
                shift
                ;;
            --no-shell)
                agent_args+=("--no-shell")
                shift
                ;;
            --detach|--no-attach)
                attach_session=false
                shift
                ;;
            --print-session)
                print_session=true
                shift
                ;;
            --)
                shift
                agent_args+=("$@")
                break
                ;;
            -h|--help)
                echo "Usage: am new [options] <directory|@spec> [-- extra-args...]"
                echo ""
                echo "If no directory specified, opens the browser on its New session section."
                echo "A directory starting with @ is resolved by the configured dir_provider"
                echo "(am config set dir_provider wp): @48351, @my-branch, or bare @."
                echo ""
                echo "Options:"
                echo "  -t, --type      Agent type (claude, codex, cursor, pi, opencode)"
                echo "  -p, --preset    Apply a saved preset (am preset list); explicit flags win"
                echo "  --shell         Open the shell panel at launch (default: agent-only)"
                echo "  --no-shell      Start agent-only even if shell_pane is enabled by default"
                echo "  --detach        Create the session without attaching"
                echo "  --print-session  Print the created session name"
                echo "  --              Pass remaining args to agent command"
                echo ""
                echo "Examples:"
                echo "  am new                          # Browser, cursor on New session"
                echo "  am new ~/project                # Specific directory"
                echo "  am new @48351                   # Directory from the provider (dir_provider)"
                echo "  printf 'Fix bug\n' | am new --detach ~/project"
                echo "  am new ~/project -- --resume    # With agent args"
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                directory="$1"
                dir_given=true
                shift
                ;;
        esac
    done

    # -p on the command line: the preset fills whatever the flags left unset.
    if [[ -n "$preset_name" ]]; then
        _cmd_new_apply_preset "$preset_name" true || return 1
    fi

    # Fully interactive: the browser with the cursor on its New session
    # section (`am-browse --new`). A launch prints one
    # __NEW_SESSION__<US>directory<US>agent<US>flags line; a session row
    # picked from the same list prints what the browser prints, handled as
    # the browser does; nothing when cancelled.
    if [[ -t 0 && "$dir_given" == false && -z "$agent_type" && ${#agent_args[@]} -eq 0 ]]; then
        local browse_cmd form_values flags _tag
        browse_cmd=$(fzf_browse_bin) || return 1
        form_values=$("$browse_cmd" --new --dir "$directory" --agent "$(am_default_agent)") || return 1
        if [[ -z "$form_values" ]]; then
            log_info "Cancelled"
            return 0
        fi
        if [[ "$form_values" != $'__NEW_SESSION__\x1f'* ]]; then
            _browse_result "$form_values"
            return
        fi

        IFS=$'\x1f' read -r _tag directory agent_type flags <<< "$form_values"
        launch_source=form
        # shellcheck disable=SC2206
        agent_args=($flags)
        # A preset row arrives as --preset=<name>; it is for us,
        # not the agent.
        local _flag _kept=() _form_preset=""
        for _flag in "${agent_args[@]}"; do
            case "$_flag" in
                --preset=*) _form_preset="${_flag#--preset=}" ;;
                *) _kept+=("$_flag") ;;
            esac
        done
        agent_args=("${_kept[@]}")
        # The line already carries the preset's fields; merge its agent args
        # and shell flag here.
        if [[ -n "$_form_preset" ]]; then
            _cmd_new_apply_preset "$_form_preset" false || return 1
        fi
    else
        if [[ "$dir_given" == false && -t 0 ]]; then
            local picked
            picked=$(fzf_pick_directory)
            if [[ -n "$picked" ]]; then
                directory="$picked"
            else
                log_info "Cancelled"
                return 0
            fi
        elif [[ "$dir_given" == false ]]; then
            directory="."
        fi

        agent_type="${agent_type:-$(am_default_agent)}"
    fi

    # `@spec` directories are resolved by the configured provider (the browser
    # skips path validation for them, so this is the one place they turn into
    # a real directory).
    if am_dir_is_spec "$directory"; then
        local spec="$directory"
        if ! directory=$(agent_dir_resolve "$directory"); then
            _launch_fail_hold "$launch_source"
            return 1
        fi
        if ! _dir_free_of_live_session "$directory" "$spec" "$launch_source"; then
            _launch_fail_hold "$launch_source"
            return 1
        fi
    fi

    initial_prompt=$(read_prompt_input)

    # Launch agent (prompt passed via _AM_LAUNCH_PROMPT to avoid tty buffer overflow
    # when piping long prompts through tmux send-keys)
    _AM_LAUNCH_PROMPT="$initial_prompt"
    _AM_LAUNCH_SOURCE="$launch_source"
    local session_name
    if ! session_name=$(agent_launch "$directory" "$agent_type" "" "${agent_args[@]}"); then
        _AM_LAUNCH_SOURCE=""
        _launch_fail_hold "$launch_source"
        return 1
    fi
    _AM_LAUNCH_SOURCE=""

    if [[ -n "$session_name" ]]; then
        if $print_session || ! $attach_session; then
            echo "$session_name"
        fi
        if $attach_session; then
            tmux_attach "$session_name"
        fi
    fi
}

# Name of the am session the caller is running inside: the AM_SESSION_NAME
# every am pane starts with, else the attached session when running on the am
# tmux server. Fails when neither.
# Usage: current_session
current_session() {
    local name="${AM_SESSION_NAME:-}"
    if [[ -z "$name" ]] && am_tmux_is_current_server; then
        name=$(am_tmux display-message -p '#{session_name}' 2>/dev/null || true)
    fi
    [[ "$name" == "${AM_SESSION_PREFIX}"* ]] || return 1
    echo "$name"
}

# Command: id — print the name of the am session we are running inside
cmd_id() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am id

Print the name of the am session this command runs inside (agent pane or
shell panel), e.g. `am send "$(am id)" ...` from a script or `am id | pbcopy`.
Every am pane also carries it as $AM_SESSION_NAME, and the status bar shows
it at the bottom right. Exits 1 outside an am session.
EOF
        return 0
    fi
    local name
    if ! name=$(current_session); then
        log_error "Not inside an am session"
        return 1
    fi
    echo "$name"
}

# Command: cd — record where the current session's agent is working now
cmd_cd() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am cd [directory]

Record that the am session this command runs inside now works in <directory>
(default: the caller's cwd). The session's tab label and branch follow it; the
launch directory is kept as-is because restore and transcript lookup key on
it. Claude Code sessions track this on their own through the state hooks (a
`cd` in the agent's shell tool is enough), so `am cd` is for agents without
hooks, for tools that hand out a checkout (`wp allocate` calls it), or to fix
a label by hand. Exits 1 outside an am session.
EOF
        return 0
    fi
    local name
    if ! name=$(current_session); then
        log_error "Not inside an am session"
        return 1
    fi
    if ! jq -e --arg n "$name" '.sessions[$n] != null' "$AM_REGISTRY" >/dev/null 2>&1; then
        log_error "Session not registered: $name"
        return 1
    fi
    local target="${1:-$PWD}" dir
    if ! dir=$(cd "$target" 2>/dev/null && pwd); then
        log_error "Not a directory: $target"
        return 1
    fi
    agent_set_workdir "$name" "$dir"
    local branch
    branch=$(registry_get_field "$name" branch)
    log_info "$name now works in $dir${branch:+ ($branch)}"
}

# Command: owner — the live session working in a directory. For tools that
# hand out and reclaim checkouts: `wp clear` refuses a copy this names, the
# mirror of am's own refusal to launch `@spec` into a busy copy.
cmd_owner() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am owner [directory]

Print the name of the live am session working in or under <directory>
(default: the caller's cwd): one launched there, or one that moved there
(`am cd`, or a `cd` the state hooks tracked). Exit 0 with the name on stdout,
1 when no live session works there, 2 when the directory does not exist.
Meant for tools that reclaim checkouts — `wp clear` refuses a copy this names
(other than the caller's own session).
EOF
        return 0
    fi
    local target="${1:-$PWD}" busy
    if [[ ! -d "$target" ]]; then
        log_error "Not a directory: $target"
        return 2
    fi
    busy=$(agent_dir_live_session "$target")
    [[ -n "$busy" ]] || return 1
    echo "$busy"
}

# Resolve a session name: try exact match, then with prefix
# Usage: resolve_session <name>
# Returns: resolved session name on stdout, or returns 1 if not found
resolve_session() {
    local name="$1"
    if tmux_session_exists "$name"; then
        echo "$name"
    elif tmux_session_exists "${AM_SESSION_PREFIX}${name}"; then
        echo "${AM_SESSION_PREFIX}${name}"
    else
        return 1
    fi
}

resolve_session_fuzzy() {
    local name="$1"

    local resolved
    if resolved=$(resolve_session "$name"); then
        echo "$resolved"
        return 0
    fi

    local matches
    matches=$(tmux_list_am_sessions | grep -i "$name" || true)
    local count
    count=$(printf '%s\n' "$matches" | grep -c .)

    if [[ $count -eq 1 ]]; then
        echo "$matches"
        return 0
    fi

    return 1
}

# Command: attach
cmd_attach() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        log_error "Session name required"
        echo "Usage: am attach <session-name>" >&2
        return 1
    fi

    # Exact, prefixed, or single fuzzy match. No sync status-bar refresh —
    # attaching does not change the session set, so precomputed options are
    # still correct.
    local resolved
    if resolved=$(resolve_session_fuzzy "$name"); then
        tmux_attach "$resolved"
        return 0
    fi

    # Zero or multiple fuzzy matches
    local matches
    matches=$(tmux_list_am_sessions | grep -i "$name" || true)
    if [[ -z "$matches" ]]; then
        log_error "No session found matching: $name"
        return 1
    fi

    log_info "Multiple matches found:"
    echo "$matches" >&2
    echo "" >&2
    echo -n "Enter session name: " >&2
    read -r selected
    if [[ -n "$selected" ]]; then
        tmux_attach "$selected"
    fi
}

# Command: shell — toggle a session's shell panel
cmd_shell() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am shell [session-name]

Toggle the session's shell panel (VS Code-style): first use opens a shell
pane below the agent; after that it hides/shows the same pane, preserving
cwd, history, and running jobs. Defaults to the current session when run
inside one. Also bound to prefix+` inside am sessions.
EOF
        return 0
    fi

    local name="${1:-}"
    local resolved=""
    if [[ -n "$name" ]]; then
        if ! resolved=$(resolve_session_fuzzy "$name"); then
            log_error "Session not found: $name"
            return 1
        fi
    elif ! resolved=$(current_session); then
        log_error "Session name required (not inside an am session)"
        echo "Usage: am shell [session-name]" >&2
        return 1
    fi

    agent_shell_pane_toggle "$resolved"
}

cmd_review() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am review [session-name]

Toggle the session's review pane: a live view of what the agent changed since
the review baseline (see 'am diff'), beside the agent — changed files with
their line counts, the diff of the selected file, hunk navigation, and 'a' to
mark the working copy reviewed. It refreshes on every tool event. First use
opens the pane; after that it hides/shows the same pane, keeping its place.
Defaults to the current session when run inside one. Also bound to prefix+v
inside am sessions. Exit 3 when the session's directory is not a repository.
EOF
        return 0
    fi

    local name="${1:-}"
    local resolved=""
    if [[ -n "$name" ]]; then
        if ! resolved=$(resolve_session_fuzzy "$name"); then
            log_error "Session not found: $name"
            return 1
        fi
    elif ! resolved=$(current_session); then
        log_error "Session name required (not inside an am session)"
        echo "Usage: am review [session-name]" >&2
        return 1
    fi

    agent_review_pane_toggle "$resolved"
}

# Append one line to $AM_DIR/queue.log for `am send --queue`: the queue
# event, then the detached helper's outcome (delivered / failed + reason).
# The helper has no terminal to report to, so this log is the only place a
# lost prompt shows up — before 0.31 its stderr went to /dev/null and two
# prompts vanished on 2026-09-10 when their workers' turns outlived the
# 600s default deadline.
# Usage: _send_queue_log <session> <event> <detail>
_send_queue_log() {
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" >> "$AM_DIR/queue.log" 2>/dev/null || true
    # Mirrored into the events log so one grep covers a session's timeline.
    am_event "queue.$2" "$1" "detail=$3"
}

# The detached half of `am send --queue`: wait for the agent, send the
# prompt held in qfile, record the outcome. On success the qfile goes; on
# failure it is kept as <qfile>.failed (the prompt is the user's, not ours to
# drop) and the log names it. Runs in a backgrounded subshell that inherits
# set -e, hence the `|| rc=$?` guards.
# Usage: _send_queue_helper <session> <qfile> <timeout_s>
_send_queue_helper() {
    local session="$1" qfile="$2" timeout_s="$3"
    local rc=0 err
    err=$("$AM_SCRIPT_DIR/am" send --wait --timeout "$timeout_s" "$session" < "$qfile" 2>&1 >/dev/null) || rc=$?
    if (( rc == 0 )); then
        rm -f "$qfile"
        _send_queue_log "$session" delivered "$(basename "$qfile")"
    else
        mv -f "$qfile" "$qfile.failed" 2>/dev/null || true
        err=${err//$'\n'/ }
        _send_queue_log "$session" failed "exit $rc: ${err:-no output}; prompt kept in $qfile.failed"
    fi
}

cmd_send() {
    local do_wait=false
    local timeout_s=""
    local force=false
    local queue=false
    local usage_line="Usage: am send [--wait|--queue|--force] [--timeout N] <session-name> [prompt]"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --wait)
                do_wait=true
                shift
                ;;
            --queue)
                queue=true
                shift
                ;;
            --force|-f)
                force=true
                shift
                ;;
            --timeout)
                timeout_s="${2:-}"
                shift 2
                ;;
            -h|--help)
                echo "$usage_line"
                echo "Read prompt text from argv or stdin and inject it into the running agent pane."
                echo ""
                echo "The prompt is sent now, mid-turn included: the agent harness takes it as"
                echo "steering or queues it for the next turn, per its own settings. Refused when"
                echo "the text would not reach the agent's input: a permission/question dialog is"
                echo "up (waiting_user) or the agent has not taken the terminal yet (starting),"
                echo "exit 4; the agent exited and the text would run in its shell (idle/dead),"
                echo "exit 2."
                echo ""
                echo "Options:"
                echo "  --wait       Deliver at the turn boundary instead: block until the agent is ready"
                echo "               (or background), then send; abort if it exits"
                echo "  --queue      Same, detached: return now, a helper sends when the agent is ready"
                echo "               or background. Outcome (delivered / failed) is one line in"
                echo "               \$AM_DIR/queue.log; an undelivered prompt is kept as queue/<file>.failed"
                echo "  --force, -f  Send regardless of state (types into a dialog or a shell)"
                echo "  --timeout N  Seconds before giving up (exit 3); 0 = no deadline. --wait default: 600;"
                echo "               --queue default: 0 — the helper waits until the agent is ready or exits"
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    local name="${1:-}"
    shift 2>/dev/null || true

    if [[ -z "$name" ]]; then
        log_error "Session name required"
        echo "$usage_line"
        return 1
    fi

    local prompt
    prompt=$(read_prompt_input "$*")

    if [[ -z "$prompt" ]]; then
        log_error "Prompt required via argv or stdin"
        echo "$usage_line"
        return 1
    fi

    local resolved
    if ! resolved=$(resolve_session_fuzzy "$name"); then
        log_error "Session not found: $name"
        return 1
    fi

    if $queue; then
        # Hand the prompt to a detached helper that waits for ready. The
        # prompt travels through a private file so its length and content
        # never hit an argv limit or a shell. No deadline unless asked: the
        # helper has nobody to tell about a timeout, and a worker's turn
        # routinely outlives any fixed number.
        am_mkdir_private "$AM_DIR/queue"
        local qfile
        qfile=$(mktemp "$AM_DIR/queue/$resolved.XXXXXX")
        printf '%s' "$prompt" > "$qfile"
        local deadline="no timeout"
        [[ -n "$timeout_s" && "$timeout_s" != 0 ]] && deadline="timeout ${timeout_s}s"
        ( _send_queue_helper "$resolved" "$qfile" "${timeout_s:-0}" ) </dev/null >/dev/null 2>&1 &
        disown
        _send_queue_log "$resolved" queued "$(basename "$qfile") helper pid $! $deadline"
        log_info "Queued for $resolved; sent when the agent is ready ($deadline, helper pid $!; outcome in $AM_DIR/queue.log)"
        return 0
    fi
    [[ -z "$timeout_s" ]] && timeout_s=600

    if ! $do_wait && ! $force; then
        _ensure_state
        local cur_state
        cur_state=$(agent_get_state "$resolved")
        # A running turn is sendable: every supported harness takes input
        # mid-turn and steers or queues it (its own config decides which).
        # Refuse only where the text would not reach the agent's input:
        # a dialog is up (Enter would answer it), the TUI is not up yet, or
        # the agent exited and the pane is a shell.
        case "$cur_state" in
            waiting_user)
                am_event send.refused "$resolved" "state=$cur_state" "exit=4" "chars=${#prompt}"
                log_error "Session $resolved is waiting_user: a permission/question dialog is up and the text would answer it; use --wait or --queue to send after it, or --force"
                return 4
                ;;
            starting)
                am_event send.refused "$resolved" "state=$cur_state" "exit=4" "chars=${#prompt}"
                log_error "Session $resolved is starting: the agent has not taken the terminal yet; use --wait or --queue to send when it has, or --force"
                return 4
                ;;
            idle|dead)
                am_event send.refused "$resolved" "state=$cur_state" "exit=2" "chars=${#prompt}"
                log_error "Session $resolved has no running agent ($cur_state); the text would run in its shell"
                return 2
                ;;
        esac
    fi

    if $do_wait; then
        _ensure_state
        # background = Claude's main turn ended, a task of its own still runs;
        # the prompt is idle and takes input, as the direct path above allows.
        local ready_states="ready,background,idle,dead"
        local reached
        reached=$(agent_wait_state "$resolved" "$ready_states" "$timeout_s")
        local wait_exit=$?
        if [[ $wait_exit -eq 1 ]]; then
            log_error "Session not found while waiting: $resolved"
            return 1
        fi
        if [[ $wait_exit -eq 3 ]]; then
            log_error "Timed out waiting for session to be ready: $resolved"
            return 3
        fi
        if [[ "$reached" == "idle" || "$reached" == "dead" ]]; then
            log_error "Session exited before prompt could be sent: $resolved"
            return 2
        fi
    fi

    agent_send_prompt "$resolved" "$prompt"
}

peek_capture_output() {
    local session_name="$1"
    local pane_name="$2"
    local lines="${3:-}"
    local pane_target
    pane_target=$(tmux_session_pane_target "$session_name" "$pane_name") || return 1

    local output
    output=$(tmux_capture_pane "$pane_target" "$lines" || true)
    if [[ -n "$output" ]]; then
        output=$(echo "$output" | sed -e :a -e '/^[[:space:]]*$/{' -e '$d' -e N -e ba -e '}')
        if [[ -n "$lines" && "$lines" =~ ^[0-9]+$ ]]; then
            echo "$output" | tail -n "$lines"
        else
            echo "$output"
        fi
    fi
}

peek_follow_logs() {
    local session_name="$1"
    local pane_name="$2"
    local lines="${3:-50}"
    local log_file
    log_file=$(tmux_session_pane_log_file "$session_name" "$pane_name") || return 1

    [[ -f "$log_file" ]] || return 1
    tail -n "$lines" -f "$log_file"
}

peek_follow_poll() {
    local session_name="$1"
    local pane_name="$2"
    local lines="${3:-50}"
    local previous=""
    local current=""

    while tmux_session_exists "$session_name"; do
        current=$(peek_capture_output "$session_name" "$pane_name" "$lines" || true)
        if [[ "$current" != "$previous" ]]; then
            if [[ -n "$previous" && "$current" == "$previous"* ]]; then
                printf '%s' "${current#$previous}"
            else
                [[ -n "$previous" ]] && printf '\n[peek refresh]\n'
                printf '%s\n' "$current"
            fi
            previous="$current"
        fi
        sleep 1
    done
}

peek_history_output() {
    local session_name="$1"
    local pane_name="$2"
    local lines="$3"
    local pattern="$4"

    local log_file
    log_file=$(tmux_session_pane_log_file "$session_name" "$pane_name") || return 1

    if [[ ! -f "$log_file" ]]; then
        log_error "Log not available: $log_file"
        log_error "Enable streaming with: am config set stream_logs true (only affects future sessions)"
        return 1
    fi

    if [[ -n "$pattern" ]]; then
        grep -E -- "$pattern" "$log_file" | tail -n "$lines"
    else
        tail -n "$lines" "$log_file"
    fi
}

cmd_peek() {
    _ensure_state
    local follow=false
    local pane_name="agent"
    local history=false
    local lines=""
    local grep_pattern=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pane)
                pane_name="${2:-}"
                shift 2
                ;;
            --follow|-f)
                follow=true
                shift
                ;;
            --history)
                history=true
                shift
                ;;
            --grep)
                grep_pattern="${2:-}"
                shift 2
                ;;
            --lines)
                lines="${2:-}"
                shift 2
                ;;
            -h|--help)
                echo "Usage: am peek [--pane agent|shell] [--follow|-f] [--lines N] <session-name>"
                echo "Show or follow another session's pane output."
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    if $history; then
        if $follow; then
            log_error "--history is incompatible with --follow"
            return 1
        fi
    elif [[ -n "$grep_pattern" ]]; then
        log_error "--grep requires --history"
        return 1
    fi

    if [[ -z "$lines" ]]; then
        if $history; then
            lines=200
        else
            lines=50
        fi
    fi

    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Session name required"
        echo "Usage: am peek [--pane agent|shell] [--follow|-f] [--lines N] <session-name>"
        return 1
    fi

    local resolved
    if ! resolved=$(resolve_session_fuzzy "$name"); then
        log_error "Session not found: $name"
        return 1
    fi

    case "$pane_name" in
        agent|top) pane_name="agent" ;;
        shell|bottom) pane_name="shell" ;;
        *)
            log_error "Unknown pane: $pane_name"
            return 1
            ;;
    esac

    # Sessions start agent-only; a shell pane exists only after it was opened.
    if [[ "$pane_name" == "shell" ]] && [[ "$(tmux_shell_pane_state "$resolved")" == "absent" ]]; then
        log_error "Session has no shell pane: $resolved"
        log_error "Open one with: am shell $resolved (or prefix+\` inside tmux)"
        return 1
    fi

    if $history; then
        peek_history_output "$resolved" "$pane_name" "$lines" "$grep_pattern"
    elif $follow; then
        if ! peek_follow_logs "$resolved" "$pane_name" "$lines"; then
            peek_follow_poll "$resolved" "$pane_name" "$lines"
        fi
    else
        peek_capture_output "$resolved" "$pane_name" "$lines"
    fi
}

# Command: kill
cmd_kill() {
    if [[ $# -eq 0 ]]; then
        log_error "Session name required (or --all / --state <list>)"
        echo "Usage: am kill <session-name> | --all | --state <s1,s2> [-y]" >&2
        return 1
    fi

    case "$1" in
        -h|--help)
            echo "Usage: am kill <session-name> | --all | --state <s1,s2> [-y]"
            echo "  --state   Kill every session whose state is in the list (asks first; -y skips)"
            return 0
            ;;
        --state|--state=*)
            local states yes=false
            if [[ "$1" == --state=* ]]; then states="${1#--state=}"; shift; else states="${2:-}"; shift 2; fi
            [[ -n "$states" ]] || { log_error "--state needs a comma-separated state list"; return 1; }
            while [[ $# -gt 0 ]]; do
                case "$1" in -y|--yes) yes=true; shift ;; *) log_error "Unknown option: $1"; return 1 ;; esac
            done
            _ensure_state
            local -a victims=()
            local s st
            while IFS= read -r s; do
                [[ -n "$s" ]] || continue
                st=$(agent_get_state "$s")
                [[ ",$states," == *",$st,"* ]] && victims+=("$s")
            done < <(tmux_list_am_sessions)
            if [[ ${#victims[@]} -eq 0 ]]; then
                log_info "No sessions in state(s): $states"
                return 0
            fi
            if ! $yes; then
                echo "Sessions in state(s) $states:" >&2
                for s in "${victims[@]}"; do echo "  $s" >&2; done
                echo -n "Kill ${#victims[@]} session(s)? [y/N] "
                local answer
                read -r answer
                [[ "$answer" == "y" || "$answer" == "Y" ]] || { log_info "Aborted"; return 0; }
            fi
            for s in "${victims[@]}"; do agent_kill "$s"; done
            log_success "Killed ${#victims[@]} session(s)"
            ;;
        --all|-a)
            local session_count
            session_count=$(tmux_count_am_sessions)
            if [[ $session_count -eq 0 ]]; then
                log_info "No sessions to kill"
                return 0
            fi
            echo -n "Kill ALL agent-manager sessions? [y/N] "
            read -r answer
            if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
                local count
                count=$(agent_kill_all)
                log_success "Killed $count sessions"
            else
                log_info "Aborted"
            fi
            ;;
        *)
            local resolved
            if resolved=$(resolve_session "$1"); then
                agent_kill "$resolved"
            else
                log_error "Session not found: $1"
                return 1
            fi
            ;;
    esac
}

# Command: config
cmd_config() {
    local subcmd="${1:-list}"
    [[ $# -gt 0 ]] && shift

    case "$subcmd" in
        list|show)
            [[ $# -eq 0 ]] || {
                log_error "Usage: am config [list|show]"
                return 1
            }
            am_config_print
            ;;
        get)
            local raw_key="${1:-}"
            if [[ -z "$raw_key" ]]; then
                log_error "Usage: am config get <agent|logs|shell|auto-restore|dir_provider|notify|notify_states|notify_cmd>"
                return 1
            fi
            local key
            if ! key=$(am_config_key_alias "$raw_key"); then
                log_error "Unknown config key: $raw_key"
                return 1
            fi
            case "$key" in
                default_agent)
                    am_default_agent
                    ;;
                stream_logs)
                    am_stream_logs_enabled && echo true || echo false
                    ;;
                shell_pane)
                    am_shell_pane_enabled && echo true || echo false
                    ;;
                auto_restore)
                    am_auto_restore_enabled && echo true || echo false
                    ;;
                dir_provider)
                    am_dir_provider
                    ;;
                notify)
                    am_notify_enabled && echo true || echo false
                    ;;
                notify_states)
                    am_notify_states
                    ;;
                notify_cmd)
                    am_config_get notify_cmd
                    ;;
            esac
            ;;
        set)
            local raw_key="${1:-}"
            local value="${2:-}"
            if [[ -z "$raw_key" || -z "$value" ]]; then
                log_error "Usage: am config set <agent|logs|shell|auto-restore|dir_provider> <value>"
                return 1
            fi
            local key key_type
            if ! key=$(am_config_key_alias "$raw_key"); then
                log_error "Unknown config key: $raw_key"
                return 1
            fi
            key_type=$(am_config_key_type "$key")
            if [[ "$key" == "default_agent" ]]; then
                value=$(agent_normalize_type "${value,,}")
            fi
            # A shell command is case-sensitive; everything else is normalized
            # to lowercase.
            [[ "$key" == "dir_provider" || "$key" == "notify_cmd" ]] || value="${value,,}"
            if ! am_config_value_is_valid "$key" "$value"; then
                log_error "Invalid value for $raw_key: $value"
                return 1
            fi
            am_config_set "$key" "$value" "$key_type"
            am_config_print
            ;;
        unset|rm)
            local raw_key="${1:-}"
            if [[ -z "$raw_key" ]]; then
                log_error "Usage: am config unset <agent|logs|shell|auto-restore|dir_provider>"
                return 1
            fi
            local key
            if ! key=$(am_config_key_alias "$raw_key"); then
                log_error "Unknown config key: $raw_key"
                return 1
            fi
            am_config_unset "$key"
            am_config_print
            ;;
        help|-h|--help)
            cat <<'EOF'
Usage:
  am config                 Show effective defaults
  am config get <key>       Get one value
  am config set <key> <v>   Save a default
  am config unset <key>     Remove a saved value

Keys:
  agent           Default agent type
  logs            Default pane log streaming (true/false)
  shell           New sessions open with the shell panel visible (true/false)
  auto-restore    Recreate open sessions after a reboot (true/false)
  dir_provider    Command behind `@spec` directories (am new @48351, `@` in the form).
                  Called as `<cmd> suggest <partial>` (lines: spec<TAB>label) and
                  `<cmd> resolve <spec>` (prints a directory), e.g.
                  am config set dir_provider wp
  notify          Desktop notification when a session needs you (true/false)
  notify_states   States that notify, comma-separated (default waiting_user;
                  add ready to hear about finished turns)
  notify_cmd      Custom notifier (bash snippet). Env: AM_NOTIFY_SESSION,
                  AM_NOTIFY_STATE, AM_NOTIFY_TITLE, AM_NOTIFY_BODY. Default:
                  osascript (macOS) / notify-send (Linux)

Precedence:
  CLI flag > environment variable > saved config > built-in default
EOF
            ;;
        *)
            log_error "Unknown config subcommand: $subcmd"
            return 1
            ;;
    esac
}

# Command: info
cmd_info() {
    _ensure_state
    local name="${1:-}"

    if [[ -z "$name" ]] && ! name=$(current_session); then
        log_error "Session name required (not inside an am session)"
        echo "Usage: am info [session-name]"
        return 1
    fi

    local resolved
    if ! resolved=$(resolve_session "$name"); then
        log_error "Session not found: $name"
        return 1
    fi

    agent_info "$resolved"
}

# Command: status
cmd_status() {
    _ensure_state
    local json=false
    local session_arg=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json|-j)
                json=true
                shift
                ;;
            -h|--help)
                echo "Usage: am status [--json] [<session-name>]"
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                session_arg="$1"
                shift
                ;;
        esac
    done

    # Single-session mode
    if [[ -n "$session_arg" ]]; then
        local resolved
        if ! resolved=$(resolve_session_fuzzy "$session_arg"); then
            log_error "Session not found: $session_arg"
            return 1
        fi

        local state
        state=$(agent_get_state "$resolved")

        if $json; then
            local fields directory branch agent_type task
            fields=$(registry_get_fields "$resolved" directory branch agent_type task)
            IFS='|' read -r directory branch agent_type task <<< "$fields"
            local activity created
            activity=$(tmux_get_activity "$resolved")
            created=$(tmux_get_created "$resolved")
            jq -n \
                --arg name "$resolved" \
                --arg state "$state" \
                --arg dir "$directory" \
                --arg branch "$branch" \
                --arg agent "$agent_type" \
                --arg task "$task" \
                --arg activity "${activity:-0}" \
                --arg created "${created:-0}" \
                '{name: $name, state: $state, directory: $dir, branch: $branch,
                  agent_type: $agent, task: $task,
                  activity: ($activity | tonumber), created: ($created | tonumber)}'
        else
            agent_info "$resolved"
            printf 'State: %s\n' "$state"
        fi

        [[ "$state" == "dead" ]] && return 2
        return 0
    fi

    # All-sessions mode
    if $json; then
        fzf_list_json
        return 0
    fi

    # Reap dead rows and refresh task fields from pane titles / transcripts.
    # Throttled to once per 60s per marker, so the cost is bounded across
    # rapid invocations.
    am_tick >/dev/null 2>&1

    local count
    count=$(tmux_count_am_sessions)

    printf '%b\n' "${BOLD}Agent Manager Status${RESET}"
    echo "===================="
    echo
    echo "Active sessions: $count"
    echo

    if [[ $count -gt 0 ]]; then
        printf '%b\n' "${BOLD}Sessions:${RESET}"
        fzf_list_simple
    else
        echo "Run 'am new' to create your first session."
    fi
}

# Command: wait
cmd_wait() {
    _ensure_state
    local target_states="ready,waiting_user,idle,dead"
    local timeout_s=600
    local json=false
    local mode="all"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --state)
                target_states="${2:-}"
                shift 2
                ;;
            --timeout)
                timeout_s="${2:-600}"
                shift 2
                ;;
            --json)
                json=true
                shift
                ;;
            --any)
                mode="any"
                shift
                ;;
            --all)
                mode="all"
                shift
                ;;
            -h|--help)
                echo "Usage: am wait [--state <states>] [--timeout N] [--json] [--any|--all] <session> [session...]"
                echo "  states: starting,running,ready,waiting_user,background,idle,unknown,dead"
                echo ""
                echo "One session: prints the state reached. Several sessions: prints"
                echo "'<session> <state>' per line; --all (default) waits for every session,"
                echo "--any returns as soon as one reaches a target state. Exit 3 = timed out."
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -eq 0 ]]; then
        log_error "Session name required"
        echo "Usage: am wait [--state <states>] [--timeout N] [--any|--all] <session> [session...]"
        return 1
    fi

    local -a resolved_list=()
    local name resolved
    for name in "$@"; do
        if ! resolved=$(resolve_session_fuzzy "$name"); then
            log_error "Session not found: $name"
            return 1
        fi
        resolved_list+=("$resolved")
    done

    # Single session: unchanged contract (state on stdout, exit code from wait).
    if [[ ${#resolved_list[@]} -eq 1 ]]; then
        local reached exit_code=0
        reached=$(agent_wait_state "${resolved_list[0]}" "$target_states" "$timeout_s") || exit_code=$?
        if $json; then
            jq -n --arg session "${resolved_list[0]}" --arg state "$reached" \
                '{session: $session, state: $state}'
        else
            echo "$reached"
        fi
        return $exit_code
    fi

    _wait_many "$mode" "$target_states" "$timeout_s" "$json" "${resolved_list[@]}"
}

# Wait on several sessions at once. Each session gets its own waiter (the
# per-session stability logic lives in agent_wait_state); results land in a
# private directory as '<state>' files named by session. --any stops at the
# first result and kills the rest; --all collects every one under a shared
# deadline. Output: '<session> <state>' lines (or a JSON array). Exit 3 when
# any requested session timed out, 1 when one vanished.
# Usage: _wait_many <any|all> <states> <timeout> <json:true|false> <session...>
_wait_many() {
    local mode="$1" target_states="$2" timeout_s="$3" json="$4"
    shift 4
    local -a sessions=("$@")
    local dir
    dir=$(mktemp -d "${TMPDIR:-/tmp}/am-wait.XXXXXX")
    local -a pids=()
    local s
    for s in "${sessions[@]}"; do
        (
            local st rc=0
            st=$(agent_wait_state "$s" "$target_states" "$timeout_s" 2>/dev/null) || rc=$?
            printf '%s\n%s\n' "$st" "$rc" > "$dir/$s.tmp"
            mv "$dir/$s.tmp" "$dir/$s"
        ) &
        pids+=($!)
    done

    local -a done_order=()
    local remaining=${#sessions[@]}
    while (( remaining > 0 )); do
        wait -n "${pids[@]}" 2>/dev/null || true
        for s in "${sessions[@]}"; do
            [[ -f "$dir/$s" ]] || continue
            local seen=false d
            for d in "${done_order[@]}"; do [[ "$d" == "$s" ]] && seen=true; done
            $seen && continue
            done_order+=("$s")
            (( remaining-- ))
        done
        [[ "$mode" == "any" && ${#done_order[@]} -gt 0 ]] && break
    done
    # Stop waiters still running (--any) and reap.
    local p
    for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done
    wait 2>/dev/null || true

    local exit_code=0 st rc
    local -a report=()
    if [[ "$mode" == "any" ]]; then
        report=("${done_order[0]}")
    else
        report=("${sessions[@]}")
    fi
    if $json; then
        local items=()
        for s in "${report[@]}"; do
            { IFS= read -r st; IFS= read -r rc; } < "$dir/$s"
            items+=("$(jq -n --arg session "$s" --arg state "$st" '{session: $session, state: $state}')")
            (( rc == 3 )) && exit_code=3
            (( rc == 1 && exit_code == 0 )) && exit_code=1
        done
        printf '%s\n' "${items[@]}" | jq -s .
    else
        for s in "${report[@]}"; do
            { IFS= read -r st; IFS= read -r rc; } < "$dir/$s"
            printf '%s %s\n' "$s" "$st"
            (( rc == 3 )) && exit_code=3
            (( rc == 1 && exit_code == 0 )) && exit_code=1
        done
    fi
    rm -rf "$dir"
    return $exit_code
}

# Command: done — a worker records its result summary for the dispatcher
cmd_done() {
    local session_arg=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --session|-s) session_arg="${2:-}"; shift 2 ;;
            -h|--help)
                echo "Usage: am done [--session <name>] [summary text]"
                echo "Record a result summary for the am session you run inside (text from argv"
                echo "or stdin). The dispatcher reads it with 'am result <session>'. Also run"
                echo "'am done' when the outcome is simply \"finished\" so the dispatcher knows."
                return 0 ;;
            -*) log_error "Unknown option: $1"; return 1 ;;
            *) break ;;
        esac
    done
    local name
    if [[ -n "$session_arg" ]]; then
        name=$(resolve_session_fuzzy "$session_arg") || { log_error "Session not found: $session_arg"; return 1; }
    elif ! name=$(current_session); then
        log_error "Not inside an am session (pass --session <name>)"
        return 1
    fi
    local text
    text=$(read_prompt_input "$*")
    [[ -n "$text" ]] || text="done"
    am_mkdir_private "$AM_DIR/results"
    printf '%s\n' "$text" > "$AM_DIR/results/$name.txt"
    log_success "Result recorded for $name (${#text} chars); read with: am result $name"
}

# Command: result — read a worker's recorded result
cmd_result() {
    local clear=false wait_for=false timeout_s=600
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clear) clear=true; shift ;;
            --wait) wait_for=true; shift ;;
            --timeout) timeout_s="${2:-600}"; shift 2 ;;
            -h|--help)
                echo "Usage: am result [--wait] [--timeout N] [--clear] <session>"
                echo "Print the summary the session recorded with 'am done'. Exit 1 when none."
                echo "  --wait     Block until a result exists (or the session ends)"
                echo "  --clear    Remove the result after printing"
                return 0 ;;
            -*) log_error "Unknown option: $1"; return 1 ;;
            *) break ;;
        esac
    done
    local name="${1:-}"
    [[ -n "$name" ]] || { log_error "Session name required"; return 1; }
    local resolved
    resolved=$(resolve_session_fuzzy "$name") || resolved="$name"
    local file="$AM_DIR/results/$resolved.txt"
    if $wait_for && [[ ! -f "$file" ]]; then
        local deadline=$(( $(date +%s) + timeout_s ))
        while [[ ! -f "$file" ]]; do
            (( $(date +%s) >= deadline )) && { log_error "Timed out waiting for a result from $resolved"; return 3; }
            tmux_session_exists "$resolved" || { log_error "Session $resolved ended without recording a result"; return 2; }
            sleep 1
        done
    fi
    [[ -f "$file" ]] || { log_error "No result recorded for $resolved"; return 1; }
    cat "$file"
    $clear && rm -f "$file"
    return 0
}

# Command: log — read the events log ($AM_DIR/events.log; see am_event in
# lib/utils.sh). One awk pass filters by session (the session column, or a
# `from=<session>` attribution) and by an ERE, then the newest N lines are
# printed as raw TSV so cut/grep/sort compose. -f keeps following.
cmd_log() {
    local n=50 pat="" follow=false name="" show_path=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--lines) n="${2:-50}"; shift 2 ;;
            -n*) n="${1#-n}"; shift ;;
            -g|--grep) pat="${2:-}"; shift 2 ;;
            -f|--follow) follow=true; shift ;;
            --path) show_path=true; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: am log [-n N] [--grep ERE] [-f] [--path] [<session>]

Print the newest lines of the events log: launches, kills, restores, sends,
provider resolves, and every failure am otherwise swallows (tmux, registry,
hook, notification, review sync). Lines are TSV:

  <utc time> TAB <component>:<pid> TAB <event> TAB <session|-> TAB k=v ...

  <session>   only lines about that session (its column, or from=<session>
              when it issued the command); closed sessions work too
  -n N        newest N lines after filtering (default 50)
  --grep ERE  keep lines matching the expression (e.g. 'fail|refused')
  -f          keep printing new lines (tail -f)
  --path      print the log path and exit

The log lives at $AM_DIR/events.log (AM_EVENTS_LOG overrides; empty
disables); the title scan caps it at 8MB, newest half kept.
EOF
                return 0 ;;
            -*) log_error "Unknown option: $1"; return 1 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ "$n" =~ ^[0-9]+$ ]] || { log_error "-n expects a number: $n"; return 1; }
    local file="${AM_EVENTS_LOG-$AM_DIR/events.log}"
    [[ -n "$file" ]] || { log_error "events log disabled (AM_EVENTS_LOG is empty)"; return 1; }
    if $show_path; then printf '%s\n' "$file"; return 0; fi
    [[ -f "$file" ]] || { log_info "no events yet ($file)"; return 0; }
    local s="" ps=""
    if [[ -n "$name" ]]; then
        s=$(resolve_session_fuzzy "$name" 2>/dev/null) || s="$name"
        ps="$AM_SESSION_PREFIX$name"
    fi
    _log_filter() {
        awk -F'\t' -v s="$s" -v ps="$ps" -v pat="$pat" \
            '(s == "" || $4 == s || $4 == ps || $5 ~ ("(^| )from=(" s "|" ps ")( |$)")) \
             && (pat == "" || $0 ~ pat)'
    }
    _log_filter < "$file" | tail -n "$n"
    if $follow; then
        tail -n 0 -f "$file" | _log_filter
    fi
    return 0
}

# Command: interrupt
cmd_interrupt() {
    _ensure_state
    local interactive=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--interactive|--confirm)
                # --confirm is the pre-0.22 spelling of the same flag (it
                # always asked); kept as an undocumented alias.
                interactive=true
                shift
                ;;
            -h|--help)
                echo "Usage: am interrupt [-i|--interactive] <session-name>"
                echo "Send Ctrl-C to the session's agent pane."
                echo ""
                echo "Options:"
                echo "  -i, --interactive  Ask for confirmation before interrupting (default: no prompt)"
                return 0
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                break
                ;;
        esac
    done

    local name="${1:-}"
    if [[ -z "$name" ]]; then
        log_error "Session name required"
        echo "Usage: am interrupt <session-name>"
        return 1
    fi

    local resolved
    if ! resolved=$(resolve_session_fuzzy "$name"); then
        log_error "Session not found: $name"
        return 1
    fi

    local state
    state=$(agent_get_state "$resolved")
    case "$state" in
        idle|dead)
            log_warn "Session is already $state; nothing to interrupt"
            return 1
            ;;
    esac

    if $interactive; then
        printf 'Interrupt session %s (state: %s)? [y/N] ' "$resolved" "$state" >&2
        local answer
        read -r answer
        [[ "$answer" == "y" || "$answer" == "Y" ]] || { log_info "Aborted"; return 0; }
    fi

    local pane_target
    pane_target=$(tmux_session_pane_target "$resolved" "agent")
    tmux_send_keys "$pane_target" "C-c"
    log_info "Sent interrupt to $resolved"
}

# Helper: compare version strings (true if actual >= required)
_install_version_ge() {
    am_version_ge "$1" "$2"
}

# Helper: check a single dependency, optionally with minimum version
_install_check_cmd() {
    local cmd="$1"
    local min_version="${2:-}"

    if ! command -v "$cmd" &>/dev/null; then
        log_warn "  $cmd ... MISSING"
        return 1
    fi

    if [[ -z "$min_version" ]]; then
        log_success "  $cmd ... OK"
        return 0
    fi

    local actual_version=""
    case "$cmd" in
        tmux) actual_version=$(tmux -V 2>/dev/null | sed -E 's/tmux ([0-9.]+).*/\1/') ;;
        fzf)  actual_version=$(fzf --version 2>/dev/null | sed -E 's/([0-9.]+).*/\1/') ;;
    esac

    if [[ -z "$actual_version" ]]; then
        log_warn "  $cmd ... version unknown (need >= $min_version)"
        return 1
    fi

    if _install_version_ge "$min_version" "$actual_version"; then
        log_success "  $cmd $actual_version ... OK (>= $min_version)"
        return 0
    else
        log_warn "  $cmd $actual_version ... too old (need >= $min_version)"
        return 1
    fi
}

_install_go_version() {
    go version 2>/dev/null | sed -E 's/^go version go([0-9]+(\.[0-9]+){1,2}).*/\1/'
}

_install_go_ready_for_build() {
    local min_version="$1"
    local actual_version

    if ! command -v go &>/dev/null; then
        log_warn "  Go not found -- run 'make build' after installing Go >= $min_version"
        return 1
    fi

    actual_version=$(_install_go_version)
    if [[ -z "$actual_version" ]]; then
        log_warn "  Go version unknown (need >= $min_version); skipping Go helper build"
        return 1
    fi

    if _install_version_ge "$min_version" "$actual_version"; then
        log_success "  Go $actual_version ... OK (>= $min_version)"
        return 0
    fi

    log_warn "  Go $actual_version ... too old for compiled helpers (need >= $min_version); skipping Go helper build"
    return 1
}

# Command: install
# --- Stale-install detection -------------------------------------------------
# `am install` derives artifacts from the checkout: skill symlinks, the Go
# binaries, the generated tmux config, and the hook registrations. When the
# checkout moves on (git pull, local edit) those go stale silently. The
# fingerprint below hashes the mtimes of every input those artifacts are built
# from; `am install` records it in $AM_DIR/.install_stamp and the browser
# compares on start, refreshing the cheap idempotent parts when it differs.

_install_inputs() {
    local root="$AM_SCRIPT_DIR"
    printf '%s\n' "$root/am" "$root/lib/tmux.sh" "$root/lib/hooks/state-hook.sh" \
        "$root/lib/hooks/am-state.ts" "$root/lib/hooks/opencode-state.js" \
        "$root/scripts/install.sh" "$root/go.mod" "$root/Makefile" \
        "$root/internal/sessions/agents.manifest"
    local f
    for f in "$root"/skills/*/SKILL.md "$root"/cmd/*/*.go "$root"/internal/*/*.go; do
        [[ -f "$f" ]] && printf '%s\n' "$f"
    done
}

# Print the fingerprint: version + a checksum over "path mtime" lines.
_install_fingerprint() {
    local -a files=()
    mapfile -t files < <(_install_inputs)
    local -A mt=()
    am_files_mtime mt "${files[@]}"
    local f acc=""
    for f in "${files[@]}"; do acc+="$f ${mt[$f]:-0}"$'\n'; done
    local sum
    sum=$(printf '%s' "$acc" | cksum | cut -d' ' -f1)
    printf '%s-%s\n' "$AM_VERSION" "$sum"
}

_install_stamp_write() {
    _install_fingerprint > "$AM_DIR/.install_stamp" 2>/dev/null || true
}

# True when the stamp is missing or differs from the current fingerprint.
_install_is_stale() {
    local stamp="" current
    [[ -f "$AM_DIR/.install_stamp" ]] && IFS= read -r stamp < "$AM_DIR/.install_stamp"
    current=$(_install_fingerprint)
    [[ "$stamp" != "$current" ]]
}

# Quiet, idempotent subset of `am install`: skill symlinks, Go binaries when a
# source is newer than the binary, tmux config, stamp. Prints one summary line.
# Usage: _install_refresh [quiet]
_install_refresh() {
    local quiet="${1:-}"
    local -a done_parts=()

    # Skills
    local skills_root="$AM_SCRIPT_DIR/skills" skills_dir skill_src skill_target
    shopt -s nullglob
    for skills_dir in "${AM_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" "${AM_CURSOR_SKILLS_DIR:-$HOME/.cursor/skills}"; do
        mkdir -p "$skills_dir" 2>/dev/null || continue
        for skill_src in "$skills_root"/*/; do
            skill_src="${skill_src%/}"
            [[ -f "$skill_src/SKILL.md" ]] || continue
            skill_target="$skills_dir/${skill_src##*/}"
            if [[ -L "$skill_target" ]]; then
                [[ "$(readlink "$skill_target")" == "$skill_src" ]] && continue
                ln -sfn "$skill_src" "$skill_target" && done_parts+=("skill ${skill_src##*/}")
            elif [[ ! -e "$skill_target" ]]; then
                ln -s "$skill_src" "$skill_target" && done_parts+=("skill ${skill_src##*/}")
            fi
        done
    done
    shopt -u nullglob

    # Go binaries: rebuild only when a source is newer than a binary (or one is missing)
    local need_build=false bin
    for bin in am-list-internal am-browse am-core am-review; do
        [[ -s "$AM_SCRIPT_DIR/bin/$bin" ]] || need_build=true
    done
    if ! $need_build; then
        local newer
        newer=$(find "$AM_SCRIPT_DIR/cmd" "$AM_SCRIPT_DIR/internal" "$AM_SCRIPT_DIR/go.mod" \
            -newer "$AM_SCRIPT_DIR/bin/am-browse" -print -quit 2>/dev/null)
        [[ -n "$newer" ]] && need_build=true
    fi
    if $need_build; then
        if command -v go >/dev/null 2>&1; then
            [[ -n "$quiet" ]] || echo "am: rebuilding Go helpers..." >&2
            # The compiler's diagnostics go to the events log: this runs
            # quietly from bare `am`, so a broken build otherwise shows up
            # only as stale binaries.
            local build_out
            if build_out=$( { cd "$AM_SCRIPT_DIR" && go build -o bin/am-list-internal ./cmd/am-list-internal/ \
                    && go build -o bin/am-browse ./cmd/am-browse/ \
                    && go build -o bin/am-core ./cmd/am-core/ \
                    && go build -o bin/am-review ./cmd/am-review/ ; } 2>&1 ); then
                done_parts+=("go binaries")
            else
                am_event install.build_fail - "rc=$?" "out=${build_out//$'\n'/ | }"
                log_warn "am: go build failed; run 'make build' to see why"
            fi
        else
            log_warn "am: Go sources changed but go is not installed; binaries may be stale"
        fi
    fi

    # tmux config (regenerated by the path helper when content changed)
    unset _AM_TMUX_CONF_CACHED
    am_tmux_config_path >/dev/null 2>&1 && done_parts+=("tmux config")

    # Cursor runs a byte copy of the state hook (scripts/install.sh writes it
    # to ~/.cursor/hooks/am-state-hook.sh); every hook edit leaves that copy
    # stale until it is rewritten. Refresh it when it exists, is ours, and
    # differs. Claude and Codex reference the checkout path and need nothing.
    local hook_src="$AM_SCRIPT_DIR/lib/hooks/state-hook.sh"
    local cursor_helper="${AM_CURSOR_HOOKS_DIR:-${CURSOR_CONFIG_DIR:-$HOME/.cursor}/hooks}/am-state-hook.sh"
    if [[ -f "$cursor_helper" && ! -L "$cursor_helper" && -f "$hook_src" ]] \
        && grep -Fq "lib/hooks/state-hook.sh - Agent hook" "$cursor_helper" 2>/dev/null \
        && ! cmp -s "$cursor_helper" "$hook_src"; then
        if cp "$hook_src" "$cursor_helper" 2>/dev/null && chmod 755 "$cursor_helper" 2>/dev/null; then
            done_parts+=("cursor hook copy")
        else
            log_warn "am: could not refresh the Cursor hook copy at $cursor_helper"
        fi
    fi

    # The Cursor hook copy resolves agent families from the manifest beside it
    # (it runs outside the repo); keep that copy current.
    local cursor_manifest="${cursor_helper%/*}/agents.manifest"
    local manifest_src="$AM_SCRIPT_DIR/lib/agents.manifest"
    if [[ -f "$cursor_helper" && ! -L "$cursor_helper" && -r "$manifest_src" ]] \
        && ! cmp -s "$cursor_manifest" "$manifest_src"; then
        if cp "$manifest_src" "$cursor_manifest" 2>/dev/null; then
            done_parts+=("cursor manifest")
        fi
    fi

    # opencode loads the state plugin from its global plugin dir; keep the
    # symlink pointed at the checkout so a moved repo leaves no dangling link.
    local opencode_plugins="${OPENCODE_PLUGINS_DIR:-$HOME/.config/opencode/plugins}"
    local opencode_src="$AM_SCRIPT_DIR/lib/hooks/opencode-state.js"
    local opencode_target="$opencode_plugins/am-state.js"
    if [[ -L "$opencode_target" || -d "$opencode_plugins" ]]; then
        mkdir -p "$opencode_plugins" 2>/dev/null || true
        if [[ -L "$opencode_target" ]]; then
            [[ "$(readlink "$opencode_target")" == "$opencode_src" ]] \
                || { ln -sfn "$opencode_src" "$opencode_target" && done_parts+=("opencode plugin"); }
        elif [[ ! -e "$opencode_target" && -f "$opencode_src" ]]; then
            ln -s "$opencode_src" "$opencode_target" && done_parts+=("opencode plugin")
        fi
    fi

    _install_stamp_write
    if [[ -z "$quiet" || ${#done_parts[@]} -gt 0 ]]; then
        local IFS=', '
        echo "am: install refreshed for $AM_VERSION (${done_parts[*]:-nothing to update})" >&2
    fi
}

# Called by the interactive browser: refresh when the checkout changed since
# the last install. AM_NO_INSTALL_REFRESH=1 disables (tests, CI).
_install_refresh_if_stale() {
    [[ -n "${AM_NO_INSTALL_REFRESH:-}" ]] && return 0
    _install_is_stale || return 0
    _install_refresh
}

# --dry-run twin of the skills step: one line per link, no mkdir.
_install_plan_skills() {
    local skills_root="$1" skills_dir="$2"
    local skill_src skill_name skill_target existing_real
    shopt -s nullglob
    for skill_src in "$skills_root"/*/; do
        skill_src="${skill_src%/}"
        [[ -f "$skill_src/SKILL.md" ]] || continue
        skill_name=$(basename "$skill_src")
        skill_target="$skills_dir/$skill_name"
        if [[ -L "$skill_target" ]]; then
            existing_real=$(cd "$(dirname "$skill_target")" 2>/dev/null && cd "$(readlink "$skill_target")" 2>/dev/null && pwd -P)
            if [[ "$existing_real" == "$skill_src" ]]; then
                echo "  keep $skill_target"
            else
                echo "would re-point $skill_target -> $skill_src"
            fi
        elif [[ -e "$skill_target" ]]; then
            echo "  leave $skill_target (not a symlink)"
        else
            echo "would link $skill_target -> $skill_src"
        fi
    done
    shopt -u nullglob
}

# Remove the skill links am install created (only links into this
# checkout's skills/; a user's own entries stay).
_uninstall_skills() {
    local dry_run="$1"
    local skills_root="$AM_SCRIPT_DIR/skills"
    local skills_dir skill_src skill_name skill_target existing_real
    shopt -s nullglob
    for skills_dir in "${AM_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" "${AM_CURSOR_SKILLS_DIR:-$HOME/.cursor/skills}"; do
        for skill_src in "$skills_root"/*/; do
            skill_src="${skill_src%/}"
            skill_name=$(basename "$skill_src")
            skill_target="$skills_dir/$skill_name"
            [[ -L "$skill_target" ]] || continue
            existing_real=$(cd "$(dirname "$skill_target")" 2>/dev/null && cd "$(readlink "$skill_target")" 2>/dev/null && pwd -P)
            [[ "$existing_real" == "$skill_src" ]] || continue
            if $dry_run; then
                echo "would remove $skill_target"
            else
                rm -f "$skill_target"
                log_success "  Removed $skill_target"
            fi
        done
    done
    shopt -u nullglob
}

cmd_uninstall() {
    local dry_run=false purge=false yes=false
    local -a fwd=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat <<'HELP'
Usage: am uninstall [--dry-run] [--purge] [-y] [--prefix <dir>] [--shell-rc <file>]

Reverse 'am install': the PATH links, the shell rc block, the am entries in
Claude Code / Codex / Cursor hook configuration, the pi extension and
opencode plugin links, and the skill links. Running sessions are left
alone (they live on am's own tmux server; 'am kill --all' stops them).

  --dry-run           Print what would be removed; change nothing
  --purge             Also remove ~/.agent-manager (config, sessions log,
                      snapshots, presets). Kept by default
  -y, --yes           Do not ask for confirmation
  --prefix <dir>      Where 'am install' put the links (default: ~/.local/bin)
  --shell-rc <file>   Shell rc file that holds the PATH block
HELP
                return 0
                ;;
            --dry-run) dry_run=true; fwd+=("$1"); shift ;;
            --purge) purge=true; shift ;;
            -y|--yes) yes=true; shift ;;
            --prefix|--shell-rc) fwd+=("$1" "$2"); shift 2 ;;
            *)
                log_error "Unknown option: $1"
                echo "Run 'am uninstall --help' for usage" >&2
                return 1
                ;;
        esac
    done

    if $dry_run; then
        echo -e "${BOLD}am uninstall --dry-run — nothing below is changed${RESET}" >&2
    else
        echo -e "${BOLD}am uninstall${RESET}" >&2
        if ! $yes; then
            local what="PATH links, shell rc block, agent hook entries, skill links"
            $purge && what+=", and $AM_DIR"
            printf 'Remove %s? [y/N] ' "$what" >&2
            local answer=""
            read -r answer || true
            [[ "$answer" == "y" || "$answer" == "Y" ]] || { echo "Uninstall cancelled" >&2; return 0; }
        fi
    fi
    echo "" >&2

    if command -v tmux >/dev/null 2>&1; then
        local live
        live=$(tmux -L "${AM_TMUX_SOCKET:-agent-manager}" list-sessions -F '#S' 2>/dev/null | grep -c "^${AM_SESSION_PREFIX:-am}-" || true)
        if [[ "${live:-0}" -gt 0 ]]; then
            log_warn "  $live am session(s) still running on tmux socket ${AM_TMUX_SOCKET:-agent-manager}; they are left alone (am kill --all stops them)"
        fi
    fi

    echo -e "${BOLD}Skill links...${RESET}" >&2
    _uninstall_skills "$dry_run"

    echo "" >&2
    echo -e "${BOLD}PATH, shell rc, agent hooks...${RESET}" >&2
    AM_INSTALL_NESTED=1 "$AM_SCRIPT_DIR/scripts/install.sh" --uninstall -y "${fwd[@]}"

    echo "" >&2
    if $purge; then
        if $dry_run; then
            echo "would remove $AM_DIR (config, sessions log, snapshots, presets)"
        elif [[ -d "$AM_DIR" ]]; then
            rm -rf "$AM_DIR"
            log_success "  Removed $AM_DIR"
        fi
    else
        echo "Kept $AM_DIR (config, sessions log, snapshots, presets): 'am uninstall --purge' removes it too." >&2
    fi
    if $dry_run; then
        echo "Dry run: nothing was changed." >&2
    else
        log_success "Uninstall complete"
    fi
}

cmd_install() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
Usage: am install [options]

First-time setup: check dependencies, create config, symlink skills,
and install am onto PATH.

  --refresh           Only refresh what the checkout derives (skill links, Go
                      binaries when sources changed, tmux config). The browser
                      runs this itself when it notices the checkout changed.
  --dry-run           Print every file the install would create, link or edit
                      (config, skills, PATH, shell rc, agent hooks, binaries)
                      and change nothing. Reverse a real install with
                      'am uninstall'.

Options (forwarded to scripts/install.sh):
  --prefix <dir>      Install directory (default: ~/.local/bin)
  --shell-rc <file>   Shell rc file to update
  --tmux-conf <file>  tmux config to clean up
  --no-shell          Skip shell rc update
  --no-tmux           Skip tmux config cleanup
  -y, --yes           Non-interactive mode
  -h, --help          Show this help
EOF
        return 0
    fi
    if [[ "${1:-}" == "--refresh" ]]; then
        source "$AM_SCRIPT_DIR/lib/tmux.sh"
        _install_refresh
        return 0
    fi

    local dry_run=false _arg
    for _arg in "$@"; do [[ "$_arg" == "--dry-run" ]] && dry_run=true; done

    if $dry_run; then
        echo -e "${BOLD}am install --dry-run — nothing below is changed${RESET}" >&2
    else
        # main() defers these for install so a dry run creates no directory
        am_init
        am_config_init
        echo -e "${BOLD}am install — first-time setup${RESET}" >&2
    fi
    echo "" >&2

    local warnings=0
    local steps_done=()

    # --- Step 1: Check dependencies ---
    echo -e "${BOLD}Checking dependencies...${RESET}" >&2
    _install_check_cmd tmux "$(am_dep_min tmux)" || (( warnings += 1 ))
    _install_check_cmd fzf "$(am_dep_min fzf)"   || (( warnings += 1 ))
    _install_check_cmd jq        || (( warnings += 1 ))
    _install_check_cmd git       || (( warnings += 1 ))
    steps_done+=("Dependencies checked")

    # --- Step 2: Create config ---
    echo "" >&2
    echo -e "${BOLD}Setting up config...${RESET}" >&2
    if $dry_run; then
        [[ -d "$AM_DIR" ]] || echo "would create $AM_DIR"
        [[ -f "$AM_CONFIG" ]] && echo "  keep $AM_CONFIG" || echo "would create $AM_CONFIG (defaults)"
    else
        log_success "  Config directory: $AM_DIR"
        log_success "  Config file: $AM_CONFIG"
        steps_done+=("Config: $AM_CONFIG")
    fi

    # --- Step 3: Symlink skills for Claude Code and Cursor discovery ---
    echo "" >&2
    echo -e "${BOLD}Setting up skills...${RESET}" >&2
    local skills_root="$AM_SCRIPT_DIR/skills"
    local skill_destinations=(
        "${AM_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
        "${AM_CURSOR_SKILLS_DIR:-$HOME/.cursor/skills}"
    )

    if [[ ! -d "$skills_root" ]]; then
        log_warn "  Skills source root not found: $skills_root"
        (( warnings += 1 ))
    else
        local skills_dir
        for skills_dir in "${skill_destinations[@]}"; do
            if $dry_run; then
                _install_plan_skills "$skills_root" "$skills_dir"
                continue
            fi
            mkdir -p "$skills_dir"

            # Remove only managed legacy symlinks. Real user directories are
            # deliberately preserved.
            local legacy_name legacy_target
            for legacy_name in am-orchestration; do
                legacy_target="$skills_dir/$legacy_name"
                if [[ -L "$legacy_target" && ! -d "$skills_root/$legacy_name" ]]; then
                    rm -f "$legacy_target"
                    log_success "  Removed legacy skill symlink: $legacy_target"
                    steps_done+=("Skill $legacy_name: legacy symlink removed")
                fi
            done

            shopt -s nullglob
            local skill_src skill_name skill_target existing
            for skill_src in "$skills_root"/*/; do
                skill_src="${skill_src%/}"
                [[ -f "$skill_src/SKILL.md" ]] || continue
                skill_name=$(basename "$skill_src")
                skill_target="$skills_dir/$skill_name"

                if [[ -L "$skill_target" ]]; then
                    existing=$(readlink "$skill_target")
                    local existing_real
                    existing_real=$(cd "$(dirname "$skill_target")" 2>/dev/null && cd "$existing" 2>/dev/null && pwd -P)
                    if [[ "$existing_real" == "$skill_src" ]]; then
                        log_success "  Symlink already exists: $skill_target"
                        steps_done+=("Skill $skill_name: verified")
                    else
                        ln -sfn "$skill_src" "$skill_target"
                        log_success "  Re-pointed: $skill_target -> $skill_src"
                        steps_done+=("Skill $skill_name: re-pointed")
                    fi
                elif [[ -e "$skill_target" ]]; then
                    log_warn "  Target exists but is not a symlink: $skill_target"
                    (( warnings += 1 ))
                else
                    ln -s "$skill_src" "$skill_target"
                    log_success "  Symlinked: $skill_target -> $skill_src"
                    steps_done+=("Skill $skill_name: symlinked")
                fi
            done
            shopt -u nullglob
        done
    fi

    # --- Step 4: Install am onto PATH (via scripts/install.sh) ---
    echo "" >&2
    echo -e "${BOLD}Installing am onto PATH...${RESET}" >&2
    AM_INSTALL_NESTED=1 "$AM_SCRIPT_DIR/scripts/install.sh" "$@"
    steps_done+=("PATH setup complete")

    # --- Step 5: Build compiled helpers ---
    echo "" >&2
    echo -e "${BOLD}Building compiled helpers...${RESET}" >&2
    local min_go_version
    min_go_version=$(am_dep_min go)
    if $dry_run; then
        if _install_go_ready_for_build "$min_go_version"; then
            echo "would build bin/am-list-internal bin/am-browse bin/am-core bin/am-review (go build)"
        else
            echo "  skip the Go build (no usable Go); am works without the browser"
        fi
        echo "would write $AM_DIR/tmux.conf and $AM_DIR/.install_stamp"
        echo "" >&2
        echo "Dry run: nothing was changed. Reverse a real install with 'am uninstall'." >&2
        return 0
    fi
    if _install_go_ready_for_build "$min_go_version"; then
        local go_ok=true
        if ( cd "$AM_SCRIPT_DIR" && go build -o bin/am-list-internal ./cmd/am-list-internal/ ) 2>&1; then
            log_success "  Built bin/am-list-internal"
        else
            log_warn "  go build failed for am-list-internal"
            go_ok=false
        fi
        if ( cd "$AM_SCRIPT_DIR" && go build -o bin/am-browse ./cmd/am-browse/ ) 2>&1; then
            log_success "  Built bin/am-browse"
        else
            log_warn "  go build failed for am-browse"
            go_ok=false
        fi
        if ( cd "$AM_SCRIPT_DIR" && go build -o bin/am-core ./cmd/am-core/ ) 2>&1; then
            log_success "  Built bin/am-core"
        else
            log_warn "  go build failed for am-core"
            go_ok=false
        fi
        if ( cd "$AM_SCRIPT_DIR" && go build -o bin/am-review ./cmd/am-review/ ) 2>&1; then
            log_success "  Built bin/am-review"
        else
            log_warn "  go build failed for am-review"
            go_ok=false
        fi
        if $go_ok; then
            steps_done+=("Go binaries built")
        else
            (( warnings += 1 ))
        fi
    else
        (( warnings += 1 ))
    fi

    # --- Step 6: Refresh dedicated tmux config ---
    echo "" >&2
    echo -e "${BOLD}Refreshing tmux config...${RESET}" >&2
    source "$AM_SCRIPT_DIR/lib/tmux.sh"
    am_tmux_config_path >/dev/null
    log_success "  Refreshed dedicated tmux config: $AM_TMUX_CONF"
    steps_done+=("tmux config refreshed")
    _install_stamp_write

    # --- Summary ---
    echo "" >&2
    echo -e "${BOLD}Summary${RESET}" >&2
    local step
    for step in "${steps_done[@]}"; do
        echo "  * $step" >&2
    done
    if [[ $warnings -gt 0 ]]; then
        log_warn "$warnings warning(s) -- review above"
    fi
    echo "" >&2
    log_success "Setup complete! Run 'am version' to verify."
}

# Main entry point
main() {
    # Initialize tracing if requested
    trace_init

    # Parse command
    local cmd="${1:-browse}"
    [[ $# -gt 0 ]] && shift

    # Install and uninstall run before the directory setup and the strict
    # dependency checks: install verifies deps itself, and a --dry-run must
    # not create $AM_DIR on the way in.
    case "$cmd" in
        install) cmd_install "$@"; return $? ;;
        uninstall) cmd_uninstall "$@"; return $? ;;
    esac

    # Initialize
    am_init
    am_config_init

    # Check dependencies
    require_cmd tmux
    require_cmd fzf
    require_cmd jq

    case "$cmd" in
        browse)
            cmd_browse
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        new|create|n)
            cmd_new "$@"
            ;;
        send)
            cmd_send "$@"
            ;;
        peek)
            cmd_peek "$@"
            ;;
        attach|a)
            cmd_attach "$@"
            ;;
        shell)
            cmd_shell "$@"
            ;;
        review)
            cmd_review "$@"
            ;;
        id|current|whoami)
            cmd_id "$@"
            ;;
        cd|workdir)
            cmd_cd "$@"
            ;;
        owner)
            cmd_owner "$@"
            ;;
        kill|rm|k)
            cmd_kill "$@"
            ;;
        config)
            cmd_config "$@"
            ;;
        info|i)
            cmd_info "$@"
            ;;
        diff)
            cmd_diff "$@"
            ;;
        status|s)
            cmd_status "$@"
            ;;
        wait)
            cmd_wait "$@"
            ;;
        done)
            cmd_done "$@"
            ;;
        result)
            cmd_result "$@"
            ;;
        doctor)
            _ensure_doctor
            doctor_main "$@"
            ;;
        log|events)
            cmd_log "$@"
            ;;
        preset|presets)
            preset_main "$@"
            ;;
        interrupt)
            cmd_interrupt "$@"
            ;;
        restore)
            cmd_restore "$@"
            ;;
        recover-open)
            cmd_recover_open "$@"
            ;;
        *)
            # If it looks like a path, treat as "new <path>"
            if [[ -d "$cmd" ]]; then
                cmd_new "$cmd" "$@"
            else
                log_error "Unknown command: $cmd"
                echo "Run 'am help' for usage"
                exit 1
            fi
            ;;
    esac
}

main "$@"
